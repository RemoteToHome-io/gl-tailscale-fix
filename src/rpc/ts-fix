-- Helper: ensure tailscale0 zone masquerade is enabled (defense-in-depth
-- for cross-subnet routing — Tailscale's built-in SNAT can fail to
-- reinitialize after daemon restart on fw3 kernels).
-- Returns true when the desired state is reached (either already set, or
-- we set it successfully). Logs and returns false on unrecoverable errors.
local function ensure_masquerade(is_49_plus)
    local c = uci.cursor()
    if not c:get(FW_CONFIG, "tailscale0") then
        ngx.log(ngx.WARN, "ts-fix: tailscale0 firewall zone not found — masquerade not configured")
        return false
    end
    -- masq6 (IPv6) is set on ALL firmware: GL never sets tailscale0.masq6 (its
    -- "IP Masquerading" toggle is IPv4-only — verified, no masq6 in
    -- /etc/firewall.tailscale.sh), and without it forwarded LAN IPv6 can't
    -- traverse the exit-node tunnel. masq (IPv4) is GL's on 4.9+, so the plugin
    -- sets it only pre-4.9 (defense-in-depth) and defers to GL otherwise.
    local want_masq = not is_49_plus
    local masq6_ok = c:get(FW_CONFIG, "tailscale0", "masq6") == "1"
    local masq_ok = (not want_masq) or c:get(FW_CONFIG, "tailscale0", "masq") == "1"
    if masq6_ok and masq_ok then
        return true  -- nothing to change
    end
    local ok = c:set(FW_CONFIG, "tailscale0", "masq6", "1")
    if want_masq then
        ok = c:set(FW_CONFIG, "tailscale0", "masq", "1") and ok
    end
    if not ok then
        ngx.log(ngx.ERR, "ts-fix: failed to set firewall.tailscale0 masquerade")
        return false
    end
    if not c:commit(FW_CONFIG) then
        ngx.log(ngx.ERR, "ts-fix: failed to commit firewall config for masquerade")
        return false
    end
    ngx.pipe.spawn({"/etc/init.d/firewall", "reload"})
    return true
end

-- Helper: find the firewall zone section whose .name='wan'. Stock GL
-- configs use anonymous sections (e.g. @zone[1]) so we can't c:get by
-- "wan" directly — iterate to locate it. Returns the section name
-- (e.g. "cfg033f8e" or "wan" for a named section) or nil.
-- First-match: if a misconfigured firewall has duplicate name='wan' zones,
-- act on the first (the iptables/nft chain GL's `wan` zone resolves to)
-- rather than the last — last-wins could land on a stale/duplicate section
-- with a different chain name. Red-team 2026-05-23.
local function find_wan_zone_section(c)
    local result = nil
    c:foreach(FW_CONFIG, "zone", function(s)
        if result == nil and s.name == "wan" then
            result = s[".name"]
        end
    end)
    return result
end

-- Helper: ensure wan-zone IPv6 masquerade when this router is acting as a
-- Tailscale exit node. Closes the pre-4.9 fw3 gap where Tailscale's own
-- ts-postrouting IPv6 chain is empty (verified empirically) AND pre-4.9
-- GL firmware doesn't reliably auto-set wan.masq6. Without it, forwarded
-- tailnet IPv6 (source fd7a:115c:a1e0::/48) exits with the ULA source
-- intact and is dropped upstream — silent IPv6 failure for tailnet clients
-- trying to use this router as an IPv6 exit node.
--
-- Sidecar flag ts-fix.settings.wan_masq6_set_by_plugin records whether WE
-- set masq6, so teardown only unsets it if our flag is on — never
-- trampling a GL- or user-managed value.
local function ensure_wan_v6_masq_for_exit_node(advertise_on)
    local c = uci.cursor()
    local wan_sec = find_wan_zone_section(c)
    if not wan_sec then
        ngx.log(ngx.WARN, "ts-fix: wan zone not found — exit-node v6 masquerade not configured")
        return
    end
    -- cur is nil (option not present), "" (rare), "0" (explicit off),
    -- or "1" (on). We distinguish "truly unset" from "user explicitly 0"
    -- so we don't trample a user's deliberate override (red-team 2026-05-23).
    local cur = c:get(FW_CONFIG, wan_sec, "masq6")
    local flag = c:get(TS_FIX_CONFIG, "settings", "wan_masq6_set_by_plugin") == "1"
    local changed = false
    if advertise_on then
        if not cur or cur == "" then
            -- masq6 truly unset → safe to set (user hasn't expressed intent)
            c:set(FW_CONFIG, wan_sec, "masq6", "1")
            c:set(TS_FIX_CONFIG, "settings", "wan_masq6_set_by_plugin", "1")
            changed = true
        elseif cur == "0" and flag then
            -- User explicitly set masq6=0 after we set it to 1. Respect the
            -- override: release ownership (clear our flag) but leave their 0.
            c:set(TS_FIX_CONFIG, "settings", "wan_masq6_set_by_plugin", "0")
            changed = true
        end
        -- If cur="0" with flag=0: user/GL chose 0, don't reclaim.
        -- If cur="1": no-op regardless of flag.
    else
        if flag then
            -- We previously set it. Delete the option (back to unset state)
            -- rather than setting to "0" — preserves the distinction between
            -- "user explicitly 0" and "option not present".
            c:delete(FW_CONFIG, wan_sec, "masq6")
            c:set(TS_FIX_CONFIG, "settings", "wan_masq6_set_by_plugin", "0")
            changed = true
        end
    end
    if changed then
        c:commit(FW_CONFIG)
        c:commit(TS_FIX_CONFIG)
        ngx.pipe.spawn({"/etc/init.d/firewall", "reload"})
    end
end

-- Helper: fix guest subnet policy route for exit node compatibility.
-- When the guest subnet is advertised, Tailscale creates a source-based rule
-- at priority 0: "from <guest_subnet> lookup main". This catches ALL traffic
-- originating from guest clients and sends it to the main table → WAN,
-- completely bypassing the exit node (priority 5270). Replace with a
-- destination-based rule: "to <guest_subnet> table main" (matching Tailscale's
-- own treatment of the LAN subnet). This preserves inbound tailnet→guest
-- reachability while letting guest clients use the exit node. Confirmed by GL
-- engineer prototype (gl_tailscale-guest). The kill switch has a routing layer
-- as well as its severed firewall forwardings (/usr/bin/ts-fix-ks): GL's
-- "from <guest_subnet>" rule would route guest traffic around that layer's
-- priority-5279 rules, so while armed the engine replaces it with this same
-- "to <guest_subnet>" rule. The delete below therefore also takes the kill
-- switch's copy, which the disabled path puts straight back via the engine.
local function fix_guest_policy_route(enabled)
    local guest_subnet = get_guest_subnet()
    if not guest_subnet then return end

    -- Always clean up both rule types to avoid duplicates
    exec("ip rule del from " .. guest_subnet .. " lookup main 2>/dev/null")
    exec("ip rule del to " .. guest_subnet .. " table main 2>/dev/null")

    if enabled then
        exec("ip rule add to " .. guest_subnet .. " table main priority 0")
    else
        -- Re-assert the kill switch's rule layer, swap included. rules-ensure takes no lock and
        -- self-gates on the committed armed intent (set_config commits before it calls this) and
        -- on Router mode, so on a disarmed router it is a no-op: the engine, not this module,
        -- decides whether anything is armed.
        exec("/usr/bin/ts-fix-ks rules-ensure </dev/null >/dev/null 2>&1")
    end
end

-- Helper: fix IoT subnet policy route for exit node compatibility. Mirrors
-- fix_guest_policy_route above, against br-iot: GL's gl_tailscale adds
-- "from <iot_subnet> lookup main" at priority 0 whenever a Custom Exit Node is
-- set and the IoT network is enabled, which routes all IoT client traffic to
-- the main table → WAN, bypassing the exit node and the kill switch's routing
-- layer. Replaced with the destination-based "to <iot_subnet> table main".
-- Since v1.0.22 the kill switch covers iot (its engine's source-rule swap keeps
-- this same rule in place of GL's "from" rule), so the disabled path re-asserts
-- the engine's layer the same way the guest path does.
local function fix_iot_policy_route(enabled)
    local iot_subnet = get_iot_subnet()
    if not iot_subnet then return end

    -- Always clean up both rule types to avoid duplicates
    exec("ip rule del from " .. iot_subnet .. " lookup main 2>/dev/null")
    exec("ip rule del to " .. iot_subnet .. " table main 2>/dev/null")

    if enabled then
        exec("ip rule add to " .. iot_subnet .. " table main priority 0")
    else
        exec("/usr/bin/ts-fix-ks rules-ensure </dev/null >/dev/null 2>&1")
    end
end

-- Firmware detection — on GL 4.9+, some features overlap with GL's native
-- Tailscale enhancements. We keep the plugin fully active but hide UI for
-- features GL provides natively (Advertise Exit Node) and skip the
-- corresponding tailscale set calls. Cached at module load (firmware
-- version doesn't change at runtime).
local function detect_firmware()
    local f = io.open("/etc/glversion", "r")
    if not f then return "", false end  -- non-GL firmware
    local line = f:read("*l") or ""
    f:close()
    local ver = line:match("^(%S+)") or ""
    local major, minor = ver:match("^(%d+)%.(%d+)")
    if not major then return ver, false end
    major, minor = tonumber(major), tonumber(minor)
    local is_49_plus = major > 4 or (major == 4 and minor >= 9)
    return ver, is_49_plus
end

local firmware_version, fw_is_49_plus = detect_firmware()

--[[
    @method-type: call
    @method-name: get_config
    @method-desc: Get ts-fix configuration and live Tailscale state

    @out bool   advertise_exit_node    Whether exit node advertisement is enabled
    @out bool   kill_switch            Whether kill switch is enabled
    @out bool   route_guest            Whether guest network routing via Tailscale is enabled
    @out bool   exit_node_active       Whether this node is currently advertising as exit node (live)
    @out bool   ts_enabled             Whether Tailscale is enabled
    @out bool   ts_running             Whether Tailscale is in Running state
    @out string ts_version             Installed Tailscale version
    @out string exit_node_ip           Currently configured remote exit node IP (from GL config)
    @out bool   kill_switch_fw_active  Whether every forwarding the kill switch severed is still severed
    @out bool   route_guest_fw_active  Whether guest→tailscale forwardings are currently active
--]]
function M.get_config()
    -- Ensure masquerade on every config read (covers first page visit after
    -- install, even if no ts-fix features are active — needed for LAN clients
    -- to reach Tailscale peers / the exit node). Sets IPv6 masq6 on all
    -- firmware (GL never does) and IPv4 masq only pre-4.9 — see ensure_masquerade.
    ensure_masquerade(fw_is_49_plus)

    local c = uci.cursor()
    local res = {}

    -- Firmware info (drives per-feature UI gating on 4.9+)
    res.firmware_version = firmware_version
    res.firmware_49_plus = fw_is_49_plus

    -- Our UCI settings
    res.advertise_exit_node = c:get(TS_FIX_CONFIG, "settings", "advertise_exit_node") == "1"
    res.kill_switch = c:get(TS_FIX_CONFIG, "settings", "kill_switch") == "1"
    res.route_guest = c:get(TS_FIX_CONFIG, "settings", "route_guest") == "1"
    res.route_iot = c:get(TS_FIX_CONFIG, "settings", "route_iot") == "1"
    res.tailscale_ssh = c:get(TS_FIX_CONFIG, "settings", "tailscale_ssh") == "1"
    res.ks_follow_exit_node = c:get(TS_FIX_CONFIG, "settings", "ks_follow_exit_node") == "1"
    res.hide_ts_domain = c:get(TS_FIX_CONFIG, "settings", "hide_ts_domain") == "1"
    res.ks_upgrade_hint_pending = c:get(TS_FIX_CONFIG, "settings", "ks_upgrade_hint_pending") == "1"

    -- GL's Tailscale UCI settings
    res.ts_enabled = c:get(TS_CONFIG, "settings", "enabled") == "1"
    res.wan_enabled = c:get(TS_CONFIG, "settings", "wan_enabled") == "1"
    res.exit_node_ip = c:get(TS_CONFIG, "settings", "exit_node_ip") or ""

    -- Skip heavy tailscale CLI calls when TS is disabled (saves ~15MB RSS
    -- per call on 512MB routers where every MB counts against OOM)
    if res.ts_enabled then
        -- Live tailscale state
        local status = tailscale_status()
        if status then
            res.ts_running = status.BackendState == "Running"
            if status.Self then
                res.exit_node_active = status.Self.ExitNodeOption == true
                -- SSH live state: SSHHostKeys is present when SSH server is active
                res.ssh_active = type(status.Self.SSHHostKeys) == "table"
                    and #status.Self.SSHHostKeys > 0
            end
        else
            res.ts_running = false
            res.exit_node_active = false
            res.ssh_active = false
        end
    else
        res.ts_running = false
        res.exit_node_active = false
        res.ssh_active = false
    end

    -- Installed version (cached per-worker; auto-invalidates on tailscaled
    -- binary mtime change so Version Manager updates reflect without an
    -- nginx restart).
    res.ts_version = get_ts_version()

    -- Kill switch state. The kill switch is firewall-zone state owned entirely by
    -- /usr/bin/ts-fix-ks, so this only VERIFIES the engine's own record: every src:dest
    -- pair listed in the ks_severed sidecar must still have a disabled forwarding behind
    -- it and no enabled one. Pure uci reads — no classification (that lives in the engine
    -- and nowhere else) and no shell-outs, because this runs on the UI's 10s poll.
    -- Fail-secure in every ambiguous direction: an empty record, a recorded pair whose
    -- sections have gone away, and a pair carrying an enabled section beside our disabled
    -- one all report false. A torn state surfaces in the UI rather than claiming protection
    -- it does not have; the engine's check pass — every watchdog poll — is what repairs it.
    local severed = c:get(TS_FIX_CONFIG, "settings", "ks_severed")
    local sev_pairs = {}
    if type(severed) == "table" then
        for _, p in ipairs(severed) do sev_pairs[#sev_pairs + 1] = p end
    elseif type(severed) == "string" then
        -- A one-element list can read back as a plain string on some uci bindings.
        for p in severed:gmatch("%S+") do sev_pairs[#sev_pairs + 1] = p end
    end
    -- The engine touches /tmp/ts-fix-ks.commit-failed when a uci commit fails: the severing
    -- then exists only as an uncommitted delta in /tmp/.uci — not persisted, not survivable
    -- across a reboot, and not something to report as protection. It outranks the pair check
    -- below and clears on the engine's first successful commit, which its check pass retries.
    local ks_ok = #sev_pairs > 0 and not fs.access("/tmp/ts-fix-ks.commit-failed")
    if ks_ok then
        -- One pass over the forwardings, keyed by pair, recording BOTH halves. GL ships
        -- anonymous and named forwarding sections and more than one can carry the same
        -- src/dest, so a pair is severed only when at least one matching section is
        -- explicitly disabled AND none is still enabled — uci's absent-enabled means
        -- enabled, so a fresh duplicate re-emitted beside our disabled one reads as not
        -- fully armed instead of masking a live egress path. src and dest are type-guarded:
        -- a hand-edited list-typed value must not raise inside this poll, where the UI's
        -- fetch swallows the error and the panel would silently stop updating.
        local pair_off, pair_on = {}, {}
        c:foreach(FW_CONFIG, "forwarding", function(s)
            if type(s.src) == "string" and type(s.dest) == "string" then
                local pair = s.src .. ":" .. s.dest
                if s.enabled == "0" then
                    pair_off[pair] = true
                else
                    pair_on[pair] = true
                end
            end
        end)
        for _, p in ipairs(sev_pairs) do
            if pair_on[p] or not pair_off[p] then
                ks_ok = false
                break
            end
        end
    end
    res.kill_switch_fw_active = ks_ok

    -- Guest routing firewall forwarding state
    res.route_guest_fw_active = c:get(FW_CONFIG, "ts_fix_guest2ts") ~= nil

    -- IoT routing firewall forwarding state
    res.route_iot_fw_active = c:get(FW_CONFIG, "ts_fix_iot2ts") ~= nil

    -- Tailscale0 zone masquerade state — reported active only when BOTH
    -- families' masquerade are set (mirrors kill_switch_fw_active semantics;
    -- a torn state surfaces in the UI rather than silently claiming
    -- protection).
    res.masquerade_active = c:get(FW_CONFIG, "tailscale0", "masq") == "1"
        and c:get(FW_CONFIG, "tailscale0", "masq6") == "1"

    return res
end

--[[
    @method-type: call
    @method-name: set_config
    @method-desc: Apply ts-fix configuration changes

    @in  bool  ?advertise_exit_node   Enable/disable exit node advertisement
    @in  bool  ?kill_switch           Enable/disable kill switch
    @in  bool  ?route_guest           Enable/disable guest network routing via Tailscale
    @in  bool  ?route_iot             Enable/disable IoT network routing via Tailscale
    @in  bool  ?tailscale_ssh         Enable/disable Tailscale SSH server
    @in  bool  ?ks_follow_exit_node   Kill switch mirrors GL's Custom Exit Node setting (watchdog-enforced)
    @in  bool  ?hide_ts_domain        Stop advertising the tailnet search domain to LAN clients

    @out bool   ?ks_mode_refused      Kill switch enable was refused — the router is not in Router mode
    @out string ?ks_mode_msg          Why it was refused, for display next to the toggle
--]]
function M.set_config(params)
    local c = uci.cursor()
    local res = {}

    -- Check tailscale is enabled
    local ts_enabled = c:get(TS_CONFIG, "settings", "enabled") == "1"
    if not ts_enabled then
        return { err_code = -1, err_msg = "Tailscale is not enabled" }
    end

    local exit_node_changed = false
    local route_changed = false
    local ssh_changed = false

    -- Handle advertise_exit_node
    if params.advertise_exit_node ~= nil then
        local val = params.advertise_exit_node and "1" or "0"
        c:set(TS_FIX_CONFIG, "settings", "advertise_exit_node", val)
        exit_node_changed = true
    end

    -- Handle kill_switch. Nothing is enforced here: /usr/bin/ts-fix-ks is the single owner of
    -- all kill-switch state, so this records the user's intent and fires the engine further
    -- down, AFTER the commit — the engine reads committed UCI, never our staged delta.
    --
    -- Enabling is refused when the router is not in Router mode: bridged/extender modes do not
    -- carry LAN traffic through the forward path, so severing forwardings would enforce nothing
    -- while the UI claimed protection. The engine refuses the same case itself (rc 2); this
    -- pre-check exists because a detached spawn's exit status is unreadable from here, and it is
    -- what lets the UI say why. An unset or unreadable mode is NOT a refusal — refusing on an
    -- unknown mode would fail open on any firmware that stops shipping the value.
    --
    -- Disabling is never refused. A user must always be able to take protection down, whatever
    -- mode the router reports — being stranded behind a kill switch is the failure this project
    -- exists to avoid.
    local ks_action = nil
    if params.kill_switch ~= nil then
        -- glconfig is none of our packages and may be absent entirely (non-GL firmware, a
        -- future rename): read it defensively and normalise every unknown shape — missing,
        -- read error, non-string — to "", which is the arm-and-let-the-engine-warn case.
        local ok_mode, mode = pcall(function()
            return c:get("glconfig", "general", "mode")
        end)
        if not ok_mode or type(mode) ~= "string" then mode = "" end
        if params.kill_switch and mode ~= "" and mode ~= "router" then
            res.ks_mode_refused = true
            res.ks_mode_msg = "The Kill Switch requires Router mode (this router is in "
                .. mode .. " mode), so it was not enabled. Any other settings you changed "
                .. "were applied."
            ngx.log(ngx.WARN, "ts-fix: refusing to enable kill switch — glconfig.general.mode='"
                .. mode .. "' bypasses the forward path")
        else
            c:set(TS_FIX_CONFIG, "settings", "kill_switch", params.kill_switch and "1" or "0")
            ks_action = params.kill_switch and "arm" or "disarm"
            -- User interacted with the KS toggle — clear the v1.0.18→v1.0.19
            -- migration hint whether they enabled or disabled it. The hint's
            -- job was to draw attention to the toggle, and they've seen it.
            c:set(TS_FIX_CONFIG, "settings", "ks_upgrade_hint_pending", "0")
        end
    end

    -- Handle route_guest
    if params.route_guest ~= nil then
        local val = params.route_guest and "1" or "0"
        c:set(TS_FIX_CONFIG, "settings", "route_guest", val)
        set_guest_ts_fw(params.route_guest)
        route_changed = true
    end

    -- Handle route_iot
    if params.route_iot ~= nil then
        local val = params.route_iot and "1" or "0"
        c:set(TS_FIX_CONFIG, "settings", "route_iot", val)
        set_iot_ts_fw(params.route_iot)
        route_changed = true
    end

    -- Handle tailscale_ssh
    if params.tailscale_ssh ~= nil then
        local val = params.tailscale_ssh and "1" or "0"
        c:set(TS_FIX_CONFIG, "settings", "tailscale_ssh", val)
        ssh_changed = true
    end

    -- Handle ks_follow_exit_node — a persistent preference, not live state.
    -- The watchdog enforces it (arms/disarms the kill switch tracking GL's
    -- exit_node_ip UCI within one 5s poll). Deliberately NOT reset by the
    -- Tailscale-disable teardown: it describes how the KS should behave
    -- whenever Tailscale is on, so it survives disable/enable cycles (the
    -- side-switch accessory relies on exactly that).
    if params.ks_follow_exit_node ~= nil then
        c:set(TS_FIX_CONFIG, "settings", "ks_follow_exit_node",
              params.ks_follow_exit_node and "1" or "0")
    end

    -- Handle hide_ts_domain — a persistent preference. The dnsmasq write itself is done by
    -- ts-fix-reapply (which owns the strip logic) and enforced by the watchdog; duplicating
    -- that logic here in a second language would buy nothing. Turning it OFF clears our
    -- ownership record so a later re-enable re-derives from the user's current value rather
    -- than restoring a stale one; GL puts its suffix back on its next trigger. No spawn is
    -- added here deliberately — the watchdog picks the new preference up within one 5s poll,
    -- exactly as ks_follow_exit_node works.
    if params.hide_ts_domain ~= nil then
        c:set(TS_FIX_CONFIG, "settings", "hide_ts_domain",
              params.hide_ts_domain and "1" or "0")
        if not params.hide_ts_domain then
            c:delete(TS_FIX_CONFIG, "settings", "user_domain")
        end
    end

    if not c:commit(TS_FIX_CONFIG) then
        ngx.log(ngx.ERR, "ts-fix: failed to commit ts-fix config in set_config")
        return { err_code = -3, err_msg = "Failed to commit settings — check /etc/config/ts-fix permissions" }
    end
    fs.sync()

    -- Apply exit node setting (only when it was actually changed).
    -- On GL 4.9+, skip entirely — GL manages this natively via run_exit_node
    -- UCI, and running tailscale set would fight its state. The UCI value is
    -- still stored above for continuity if the user ever downgrades to 4.8.x.
    if exit_node_changed and not fw_is_49_plus then
        local advertise = c:get(TS_FIX_CONFIG, "settings", "advertise_exit_node") == "1"
        if advertise then
            exec("/usr/sbin/tailscale set --advertise-exit-node 2>/dev/null")
        else
            exec("/usr/sbin/tailscale set --advertise-exit-node=false 2>/dev/null")
        end
        -- Ensure wan-zone IPv6 masquerade so tailnet clients can use this
        -- router as an IPv6 exit node. Closes pre-4.9 fw3 gap where
        -- Tailscale's own ts-postrouting v6 chain is empty.
        ensure_wan_v6_masq_for_exit_node(advertise)
    end

    -- Apply SSH setting (only when it was actually changed)
    if ssh_changed then
        local ssh = c:get(TS_FIX_CONFIG, "settings", "tailscale_ssh") == "1"
        if ssh then
            exec("/usr/sbin/tailscale set --ssh 2>/dev/null")
        else
            exec("/usr/sbin/tailscale set --ssh=false 2>/dev/null")
        end
    end

    -- Apply route changes (only when route_guest or route_iot was actually changed)
    if route_changed then
        local rg = c:get(TS_FIX_CONFIG, "settings", "route_guest") == "1"
        update_guest_route(rg)
        -- Fix policy route: swap Tailscale's "from <guest>" (blocks the exit
        -- node) with "to <guest>" (allows it). Must run after
        -- update_guest_route which triggers Tailscale to create its rules.
        fix_guest_policy_route(rg)

        local ri = c:get(TS_FIX_CONFIG, "settings", "route_iot") == "1"
        update_iot_route(ri)
        -- Same policy route fixup for the IoT subnet.
        fix_iot_policy_route(ri)
    end

    -- Ensure tailscale0 zone masquerade (defense-in-depth for subnet routing +
    -- IPv6 through the exit node). masq6 on all firmware, IPv4 masq pre-4.9.
    ensure_masquerade(fw_is_49_plus)

    -- Fire the kill-switch engine. It self-gates on COMMITTED intent (kill_switch=1 AND
    -- Tailscale enabled), so this MUST come after the ts-fix commit above or an arm would be a
    -- logged no-op. It also lands after the masquerade and guest-routing writes so our own uci
    -- commits on the firewall package never overlap the engine's.
    --
    -- Detached, with stdin redirected as well as stdout/stderr: arm severs forwardings, commits
    -- both packages and reloads the firewall, which is far too slow to hold an RPC response
    -- open, and sh exits immediately so the child is reparented away from this nginx worker.
    -- Its exit status is therefore unreadable here by construction — the mode pre-check above
    -- covers the one refusal a user needs told about, and the watchdog's 5s check pass is the
    -- retry for an engine failure. ks_action is our own literal, never user input.
    if ks_action then
        ngx.pipe.spawn({"sh", "-c",
            "/usr/bin/ts-fix-ks " .. ks_action .. " </dev/null >/dev/null 2>&1 &"})
    end

    -- Exit-node reconcile fast path (v1.0.22): GL's exit_node_ip UCI is the
    -- authoritative exit-node intent; push it to the daemon when the two
    -- disagree. On buggy tiny Tailscale builds (ts_omit_ipnbus, before the
    -- upstream fix 2026-06-04) GL's "tailscale up --reset" can fail to
    -- dispatch exit-node changes — most visibly the CLEAR direction, leaving
    -- the daemon routing through an exit node the user disabled. This is the
    -- fastest recovery when the page is open (the JS post-Apply reapply calls
    -- set_config after GL's restart settles); ts-fix-reapply and the watchdog
    -- cover headless paths. All firmware — the bug is binary-side, not 4.9
    -- (reproduced live on 4.8.5, E5800 control matrix 2026-06-03).
    --
    -- SET is snapshot-gated (last_seen_exit_node_ip, owned by ts-fix-reapply)
    -- so a stale pre-4.9 UCI value left behind by an old GL disable can't
    -- resurrect a long-dead exit node; CLEAR is ungated — a daemon routing
    -- with no configured exit node is reconciled whenever seen. Detached
    -- spawn: "tailscale set" can block on the buggy binaries, and it must
    -- never stall this RPC response (sh exits immediately; the backgrounded
    -- call is reparented away from the worker).
    local gl_exit_ip = c:get(TS_CONFIG, "settings", "exit_node_ip") or ""
    -- No -x (see tailscale_status): BusyBox pgrep -x never matches the
    -- path-invoked daemon, which would silently skip this reconcile forever.
    if exec_rc("pgrep tailscaled >/dev/null 2>&1") == 0 then
        local prefs_raw = exec("timeout 3 /usr/sbin/tailscale debug prefs 2>/dev/null")
        local okp, prefs = pcall(cjson.decode, prefs_raw or "")
        local eid = ""
        if okp and type(prefs) == "table" and type(prefs.ExitNodeID) == "string" then
            eid = prefs.ExitNodeID
        end
        local last_seen = c:get(TS_FIX_CONFIG, "settings", "last_seen_exit_node_ip") or ""
        if gl_exit_ip == "" and eid ~= "" then
            ngx.log(ngx.WARN, "ts-fix: exit node cleared in UCI but daemon ExitNodeID stuck — reconciling")
            ngx.pipe.spawn({"sh", "-c",
                "timeout 10 /usr/sbin/tailscale set --exit-node= >/dev/null 2>&1 &"})
        elseif gl_exit_ip ~= "" and eid == "" and gl_exit_ip ~= last_seen
               and gl_exit_ip:match("^[%w%.%:%-]+$") then
            -- Charset guard keeps the UCI value shell-safe (IP/hostname
            -- characters only) before interpolation into the sh -c string.
            ngx.log(ngx.WARN, "ts-fix: exit node set in UCI but daemon ExitNodeID empty — reconciling")
            ngx.pipe.spawn({"sh", "-c",
                "timeout 10 /usr/sbin/tailscale set --exit-node='" .. gl_exit_ip .. "' >/dev/null 2>&1 &"})
        end
    end

    -- Empty on the normal path; carries ks_mode_refused + ks_mode_msg when the kill-switch
    -- enable was refused above. Deliberately NOT an err_code: every other setting in the same
    -- Apply was written, so the UI reverts the one toggle rather than all of them.
    return res
end

--[[
    @method-type: call
    @method-name: get_update_info
    @method-desc: Get installed and latest Tailscale version info

    @out string installed_version   Currently installed version (base X.Y.Z, for display)
    @out string installed_full      Installed version incl. build suffix (comparison)
    @out string latest_version      Latest version available (base X.Y.Z, for display)
    @out string latest_full         Latest version incl. build suffix (comparison)
    @out bool   update_available    Whether an update is available (full-string compare)
    @out bool   is_rebuild          Update is an in-place rebuild (same base, new build suffix)
    @out string arch                Detected architecture
--]]
function M.get_update_info()
    local res = {}

    -- Installed version (cached per-worker with mtime invalidation).
    -- Base for display, full string for comparison.
    res.installed_version = get_ts_version()
    res.installed_full = get_ts_version_full()

    -- Architecture (hardcoded after first call — doesn't change at runtime)
    local arch = exec("uname -m 2>/dev/null")
    res.arch = arch and arch:match("^(%S+)") or "unknown"

    -- Check for cached latest version (updated by ts-fix-update --check; a
    -- full string like "1.98.8-tiny.by.admon.1320" since v1.0.22 — legacy
    -- caches from older versions hold the base only, handled below)
    local cache_file = "/tmp/ts-fix-latest-version"
    if fs.access(cache_file) then
        local f = io.open(cache_file, "r")
        if f then
            res.latest_full = f:read("*l") or "unknown"
            f:close()
        else
            res.latest_full = "unknown"
        end
        res.latest_version = base_ver(res.latest_full) or res.latest_full
        -- Background refresh if cache is stale (returns cached value, no UI flash)
        if is_cache_stale(cache_file) then
            ngx.pipe.spawn({"/usr/bin/ts-fix-update", "--check"})
        end
    else
        -- No cache — trigger async version check
        ngx.pipe.spawn({"/usr/bin/ts-fix-update", "--check"})
        res.latest_version = "checking..."
        res.latest_full = "checking..."
    end

    -- Update decision. Different base version → update (unchanged semantics).
    -- Same base version → update only when the remote declares a build suffix
    -- that differs from the installed one: upstream replaces release assets in
    -- place under the same base (the 2026-06-04 ipnbus fix shipped that way),
    -- and a base-only compare left routers stuck on the buggy build reporting
    -- "Already at latest". Requiring a remote suffix also keeps a legacy
    -- base-only cache (pre-v1.0.22) from offering a phantom rebuild.
    res.update_available = false
    res.is_rebuild = false
    if res.installed_full ~= "unknown" and res.latest_full ~= "unknown"
       and res.latest_full ~= "checking..." then
        local same_base = base_ver(res.installed_full) == base_ver(res.latest_full)
        if not same_base then
            res.update_available = true
        elseif res.latest_full:find("-", 1, true)
               and res.installed_full ~= res.latest_full then
            res.update_available = true
            res.is_rebuild = true
        end
    end

    return res
end

--[[
    @method-type: call
    @method-name: do_update
    @method-desc: Update Tailscale to the latest version

    @out number ?err_code   Error code
    @out string ?err_msg    Error message
    @out string ?status     Status message
--]]
function M.do_update()
    -- Check if update is already running
    if fs.access("/tmp/ts-fix-update.lock") then
        return { err_code = -1, err_msg = "Update already in progress" }
    end

    -- Clear cached version (binary will change)
    cached_ts_version = nil

    -- Launch update in background
    ngx.pipe.spawn({"/usr/bin/ts-fix-update", "--install"})

    return { status = "update_started" }
end

--[[
    @method-type: call
    @method-name: get_update_status
    @method-desc: Get status of a running or completed update

    @out string status   "idle", "running", "success", "error"
    @out string message  Status or error message
--]]
function M.get_update_status()
    local status_file = "/tmp/ts-fix-update.status"
    if fs.access(status_file) then
        local f = io.open(status_file, "r")
        if f then
            local content = f:read("*a")
            f:close()
            local ok, data = pcall(cjson.decode, content)
            if ok then return data end
        end
    end
    return { status = "idle", message = "" }
end

--[[
    @method-type: call
    @method-name: do_restore
    @method-desc: Restore factory Tailscale binaries from /rom/

    @out number ?err_code   Error code
    @out string ?err_msg    Error message
--]]
function M.do_restore()
    -- Check /rom/ has factory binaries
    if not fs.access("/rom/usr/sbin/tailscale") then
        return { err_code = -1, err_msg = "Factory binaries not found in /rom/" }
    end

    -- Clear cached version (binary will change)
    cached_ts_version = nil

    ngx.pipe.spawn({"/usr/bin/ts-fix-update", "--restore"})
    return { status = "restore_started" }
end

--[[
    @method-type: call
    @method-name: get_plugin_info
    @method-desc: Get latest gl-tailscale-fix version from GitHub releases

    @out string latest_version   Latest plugin version ("checking...", "unavailable", or version string)
    @out string release_url      URL to the latest release page
--]]
function M.get_plugin_info()
    local res = {}
    local cache_file = "/tmp/ts-fix-plugin-latest-version"

    if fs.access(cache_file) then
        local f = io.open(cache_file, "r")
        if f then
            local version = f:read("*l") or ""
            local url = f:read("*l") or ""
            f:close()
            if version ~= "" then
                res.latest_version = version
                res.release_url = url
            else
                res.latest_version = "unavailable"
                res.release_url = ""
            end
        else
            res.latest_version = "unavailable"
            res.release_url = ""
        end
        -- Background refresh if cache is stale (returns cached value, no UI flash)
        if is_cache_stale(cache_file) then
            ngx.pipe.spawn({"/usr/bin/ts-fix-update", "--check-plugin"})
        end
    else
        -- No cache — trigger async version check
        ngx.pipe.spawn({"/usr/bin/ts-fix-update", "--check-plugin"})
        res.latest_version = "checking..."
        res.release_url = ""
    end

    return res
end

--[[
    @method-type: call
    @method-name: force_check_versions
    @method-desc: Force re-check of both Tailscale and plugin versions (clears cache)
--]]
function M.force_check_versions()
    ngx.pipe.spawn({"/usr/bin/ts-fix-update", "--check"})
    ngx.pipe.spawn({"/usr/bin/ts-fix-update", "--check-plugin"})
    return {}
end

--[[
    @method-type: call
    @method-name: dismiss_ks_hint
    @method-desc: Dismiss the post-upgrade "re-enable Kill Switch" hint.
    Called from the UI dismiss button; also cleared automatically when the
    user enables the kill switch via set_config.
--]]
function M.dismiss_ks_hint()
    local c = uci.cursor()
    if not c:set(TS_FIX_CONFIG, "settings", "ks_upgrade_hint_pending", "0") then
        return { err_code = -1, err_msg = "Failed to update ts-fix config" }
    end
    if not c:commit(TS_FIX_CONFIG) then
        return { err_code = -2, err_msg = "Failed to commit ts-fix config" }
    end
    return {}
end

return M
