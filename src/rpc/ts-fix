local uci = require "uci"
local cjson = require "cjson"
local fs = require "oui.fs"

local M = {}

local TS_FIX_CONFIG = "ts-fix"
local FW_CONFIG = "firewall"
local TS_CONFIG = "tailscale"

-- Version check cache TTL (72 hours)
local CACHE_TTL = 259200

-- Cached tailscale version (base for display, full string for update
-- comparison). Invalidated per-worker when the tailscaled binary mtime
-- changes (i.e. the Version Manager ran an update/restore). Multiple nginx
-- workers each hold their own cache; mtime check ensures every worker
-- re-reads after an update, without a nginx restart.
local cached_ts_version = nil
local cached_ts_version_full = nil
local cached_ts_version_mtime = 0

-- Helper: strip version suffix (e.g. "1.94.2-tiny.by.admon.1187" → "1.94.2")
local function base_ver(v)
    if v then return v:match("^([%d%.]+)") end
    return v
end

-- Helper: run a command and return stdout
local function exec(cmd)
    local r = ngx.pipe.spawn({"sh", "-c", cmd})
    if r then
        local data = r:stdout_read_all()
        r:wait()
        return data
    end
    return nil
end

-- Helper: get mtime of a file as unix seconds. Returns 0 if unavailable.
-- Uses "date -r" (BusyBox) since GL routers don't ship stat in PATH.
local function file_mtime(path)
    local r = ngx.pipe.spawn({"date", "-r", path, "+%s"})
    if not r then return 0 end
    local data = r:stdout_read_all()
    r:wait()
    return tonumber((data or ""):match("^(%d+)")) or 0
end

-- Helper: get installed tailscale version. Caches per-worker and
-- invalidates on tailscaled binary mtime change (Version Manager updates).
-- Both forms come from the same "tailscale version" first line, which on
-- tiny builds is the full suffixed string (verified live on MT3000:
-- "1.98.8-tiny.by.admon.1320").
local function refresh_ts_version()
    local mtime = file_mtime("/usr/sbin/tailscaled")
    if cached_ts_version and mtime > 0 and mtime == cached_ts_version_mtime then
        return
    end
    local ver = exec("/usr/sbin/tailscale version 2>/dev/null")
    local first = ver and ver:match("^(%S+)") or nil
    cached_ts_version_full = first or "unknown"
    cached_ts_version = first and base_ver(first) or "unknown"
    cached_ts_version_mtime = mtime
end

local function get_ts_version()
    refresh_ts_version()
    return cached_ts_version
end

local function get_ts_version_full()
    refresh_ts_version()
    return cached_ts_version_full
end

-- Helper: check if a cache file is stale (older than CACHE_TTL seconds)
-- Uses "date -r" (BusyBox) since GL routers don't have stat in PATH.
-- Array-form spawn avoids shell interpolation of path.
local function is_cache_stale(path)
    if not fs.access(path) then return true end
    local r = ngx.pipe.spawn({"date", "-r", path, "+%s"})
    if not r then return true end
    local mtime_str = r:stdout_read_all()
    r:wait()
    if not mtime_str then return true end
    local mtime = tonumber(mtime_str:match("^(%d+)"))
    if not mtime then return true end
    return (ngx.time() - mtime) >= CACHE_TTL
end

-- Helper: run a command and return exit code
-- Reads the shell's own $? out of stdout rather than trusting proc:wait().
--
-- On GL's lua-nginx build a NONZERO exit was measured still reading as ok
-- (gl-zerotier-fix U1 session, MT3000 4.9.0 / nginx 1.26.1, 2026-08-08: an
-- rc-based boolean reported transport_route4:true against an empty table 310).
-- Under that semantic every caller here gets a wrong-positive — which would
-- silently disable the pgrep guard below and reintroduce the OOM-amplification
-- path it exists to prevent, on exactly the 512MB routers that need it.
--
-- Appending the status is correct under EITHER wait() semantic, so this does not
-- depend on which build is running and needs no firmware gate. The braces keep
-- the caller's redirections scoped to their own command.
local function exec_rc(cmd)
    local out = exec("{ " .. cmd .. " ; } ; echo __RC=$?")
    if not out then return 1 end
    local rc = out:match("__RC=(%d+)%s*$")
    return tonumber(rc) or 1
end

-- Helper: get tailscale status JSON
-- Guards with pgrep first — if tailscaled isn't running, returns nil
-- immediately instead of spawning a ~60MB Go process that hangs for 3s
-- until timeout. Prevents OOM amplification loops on 512MB routers where
-- dead tailscaled + piling CLI processes exhaust all memory.
-- No -x: BusyBox pgrep -x anchors on the FULL cmdline, so it never matches
-- a path-invoked daemon ("/usr/sbin/tailscaled --port ..." != "tailscaled";
-- measured live, MT3000 BusyBox 1.33.2). The old wait()-trusting exec_rc
-- masked that by returning 0 for everything; with honest exit codes the -x
-- form would report the daemon dead while it runs. Substring form matches
-- the shell scripts' established idiom.
local function tailscale_status()
    if exec_rc("pgrep tailscaled >/dev/null 2>&1") ~= 0 then
        return nil
    end
    local data = exec("timeout 3 /usr/sbin/tailscale status --json 2>/dev/null")
    if data and #data > 0 then
        local ok, r = pcall(cjson.decode, data)
        if ok and type(r) == "table" then
            return r
        end
    end
    return nil
end

-- Helper: get the guest network as NETWORK/PREFIX for br-guest's IPv4 address, or nil.
-- The network comes from /bin/ipcalc.sh, the tool GL's own script relies on, never from zeroing the
-- last octet: that is right only for a /24 (192.168.9.1/23 is network 192.168.8.0/23), and a
-- wrong network misses GL's "from <net>" rule in fix_guest_policy_route and advertises a route that
-- is not a network address. Both values end up in "sh -c" strings: the address capture admits only
-- digits, dots and one slash, and the result must match the CIDR pattern below or nil is returned.
local function get_guest_subnet()
    local data = exec("ip -4 addr show br-guest 2>/dev/null") or ""
    local addr = data:match("inet (%d+%.%d+%.%d+%.%d+/%d+)")
    if not addr then return nil end
    local calc = exec("/bin/ipcalc.sh " .. addr .. " 2>/dev/null") or ""
    local network = calc:match("NETWORK=([^\n]*)")
    local prefix = calc:match("PREFIX=([^\n]*)")
    if not network or not prefix then return nil end
    local cidr = network .. "/" .. prefix
    if not cidr:match("^%d+%.%d+%.%d+%.%d+/%d+$") then return nil end
    return cidr
end

-- Helper: get the IoT network as NETWORK/PREFIX for br-iot's IPv4 address, or nil. The network
-- comes from /bin/ipcalc.sh, the tool GL's own script relies on, never from zeroing the last
-- octet: that is right only for a /24 (192.168.10.1/23 is network 192.168.10.0/23), and a wrong
-- network misses GL's "from <net>" rule in fix_iot_policy_route and advertises a route that is
-- not a network address. Both values end up in "sh -c" strings: the address capture admits only
-- digits, dots and one slash, and the result must match the CIDR pattern below or nil is returned.
local function get_iot_subnet()
    local data = exec("ip -4 addr show br-iot 2>/dev/null") or ""
    local addr = data:match("inet (%d+%.%d+%.%d+%.%d+/%d+)")
    if not addr then return nil end
    local calc = exec("/bin/ipcalc.sh " .. addr .. " 2>/dev/null") or ""
    local network = calc:match("NETWORK=([^\n]*)")
    local prefix = calc:match("PREFIX=([^\n]*)")
    if not network or not prefix then return nil end
    local cidr = network .. "/" .. prefix
    if not cidr:match("^%d+%.%d+%.%d+%.%d+/%d+$") then return nil end
    return cidr
end

-- Helper: get currently advertised routes from tailscale prefs
local function get_current_routes()
    local data = exec("/usr/sbin/tailscale debug prefs 2>/dev/null")
    if data then
        local ok, prefs = pcall(cjson.decode, data)
        if ok and type(prefs.AdvertiseRoutes) == "table" then
            return prefs.AdvertiseRoutes
        end
    end
    return {}
end

-- Helper: update advertised routes, adding or removing guest subnet
local function update_guest_route(enable)
    local guest_subnet = get_guest_subnet()
    if not guest_subnet then return end

    local routes = get_current_routes()
    local new_routes = {}
    local found = false

    for _, route in ipairs(routes) do
        if route == guest_subnet then
            found = true
            if enable then
                new_routes[#new_routes + 1] = route
            end
        else
            new_routes[#new_routes + 1] = route
        end
    end

    if enable and not found then
        new_routes[#new_routes + 1] = guest_subnet
    end

    -- Validate every route before it reaches the shell. exec() runs its argument
    -- through "sh -c", and these values arrive from the daemon's prefs — a trust
    -- boundary we do not own — so an entry carrying shell metacharacters would run
    -- as root. Same charset gate already applied to the exit-node interpolation.
    -- Abort rather than filter: silently dropping an entry would rewrite the user's
    -- advertised routes, so if the input can't be trusted, leave them untouched.
    for _, route in ipairs(new_routes) do
        if not route:match("^[%x%.:/]+$") then
            exec("logger -t ts-fix 'refusing to set advertised routes: daemon prefs contained an unexpected character'")
            return
        end
    end

    local routes_str = table.concat(new_routes, ",")
    exec("/usr/sbin/tailscale set --advertise-routes=" .. routes_str .. " 2>/dev/null")
end

-- Helper: update advertised routes, adding or removing IoT subnet
local function update_iot_route(enable)
    local iot_subnet = get_iot_subnet()
    if not iot_subnet then return end

    local routes = get_current_routes()
    local new_routes = {}
    local found = false

    for _, route in ipairs(routes) do
        if route == iot_subnet then
            found = true
            if enable then
                new_routes[#new_routes + 1] = route
            end
        else
            new_routes[#new_routes + 1] = route
        end
    end

    if enable and not found then
        new_routes[#new_routes + 1] = iot_subnet
    end

    local routes_str = table.concat(new_routes, ",")
    exec("/usr/sbin/tailscale set --advertise-routes=" .. routes_str .. " 2>/dev/null")
end

-- Helper: set guest→tailscale firewall forwardings enabled/disabled
local function set_guest_ts_fw(enabled)
    local c = uci.cursor()
    local changed = false

    local forwardings = {
        {name = "ts_fix_guest2ts", src = "guest", dest = "tailscale0"},
        {name = "ts_fix_ts2guest", src = "tailscale0", dest = "guest"},
    }

    for _, fwd in ipairs(forwardings) do
        local exists = c:get(FW_CONFIG, fwd.name)
        if exists and not enabled then
            c:delete(FW_CONFIG, fwd.name)
            changed = true
        elseif not exists and enabled then
            c:set(FW_CONFIG, fwd.name, "forwarding")
            c:set(FW_CONFIG, fwd.name, "src", fwd.src)
            c:set(FW_CONFIG, fwd.name, "dest", fwd.dest)
            changed = true
        end
    end

    if changed then
        c:commit(FW_CONFIG)
        ngx.pipe.spawn({"/etc/init.d/firewall", "reload"})
    end

    return changed
end

