#!/bin/sh
# gl-tailscale-fix: Tailscale binary updater
# Copyright (c) 2026 RemoteToHome Consulting (https://remotetohome.io)
# https://github.com/RemoteToHome-io/gl-tailscale-fix
# Combined binaries from admonstrator/glinet-tailscale-updater
set -e

# `timeout` ships in ROM on GL 4.8.4, 4.9.0 and 4.11. Where it is missing, run the command
# unbounded as before rather than not at all: without it every bounded call would fail with 127.
command -v timeout >/dev/null 2>&1 || timeout() { shift; "$@"; }

LOCK="/tmp/ts-fix-update.lock"
STATUS="/tmp/ts-fix-update.status"
CACHE="/tmp/ts-fix-latest-version"
PLUGIN_CACHE="/tmp/ts-fix-plugin-latest-version"
# The binary, service, keep-list and reference-binary paths can be overridden from the environment
# so that tests/unit/test-keep-binary.sh and tests/unit/test-arch-select.sh can point them into a
# temp dir; nothing sets them in production.
TS_BIN=${TS_BIN:-/usr/sbin/tailscale}
TS_DAEMON=${TS_DAEMON:-/usr/sbin/tailscaled}
TS_INIT=${TS_INIT:-/etc/init.d/tailscale}
# Restore copies the factory binaries from the read-only firmware image mounted here
ROM_PREFIX=${ROM_PREFIX:-/rom}
# Second keep list, present only while a Version Manager binary is installed (see keep_write)
KEEP_BIN=${KEEP_BIN:-/lib/upgrade/keep.d/gl-tailscale-fix-tailscale}
# A binary this router runs: its ELF header gives the router's byte order (see elf_order)
REF_ELF=${REF_ELF:-/bin/busybox}
SYSUPGRADE_CONF="/etc/sysupgrade.conf"

# Combined multi-call binaries hosted by Admonstrator
# These are single binaries that act as both tailscale CLI and tailscaled daemon
# (standard pkgs.tailscale.com tarballs ship separate non-multi-call binaries
# that are too large for flash-constrained routers)
TINY_URL="https://github.com/Admonstrator/glinet-tailscale-updater/releases/latest/download"

# elf_order <file>: "le" or "be" from byte 5 of <file>'s ELF header (EI_DATA: 1 little-endian,
# 2 big-endian), or nothing when <file> is missing, unreadable or not ELF. Byte 4 (EI_CLASS) may be
# 1 or 2. Bytes 0-5 of an ELF file hold no NUL, which $( ) would drop. dd, not od: the GL builds
# checked have no od.
elf_order() {
    local h
    h=$(dd if="$1" bs=1 count=6 2>/dev/null) || h=""
    case "$h" in
        "$(printf '\177ELF\001\001')"|"$(printf '\177ELF\002\001')") echo "le" ;;
        "$(printf '\177ELF\001\002')"|"$(printf '\177ELF\002\002')") echo "be" ;;
    esac
}

# Architecture mapping (matches Admonstrator's release naming)
detect_arch() {
    case "$(uname -m)" in
        aarch64)    echo "arm64" ;;
        armv7l)     echo "arm" ;;
        # A 32-bit MIPS kernel reports "mips" for both byte orders, so take the order from a
        # binary this router runs: a little-endian MT7621 (GL-MG1300) needs mipsle, not mips.
        mips)
            case "$(elf_order "$REF_ELF")" in
                le) echo "mipsle" ;;
                be) echo "mips" ;;
                *)  echo "" ;;
            esac
            ;;
        mipsel)     echo "mipsle" ;;
        x86_64)     echo "amd64" ;;
        *)          echo "" ;;
    esac
}

# Extract base version (X.Y.Z) from version strings like "1.94.2-tiny.by.admon.1187"
base_ver() {
    echo "$1" | sed 's/-.*//'
}

set_status() {
    printf '{"status":"%s","message":"%s"}' "$1" "$2" > "$STATUS"
}

cleanup() {
    # Guaranteed terminal status: if we are exiting while the status file still
    # says "running", the script died unexpectedly (set -e, a timeout, OOM kill)
    # and the UI would otherwise show a stuck spinner forever — observed live
    # 2026-07-05 when a download died mid-transfer on a degraded tunnel path.
    # Normal success/error paths write their status before exiting, so this
    # only fires on abnormal exits. (kill -9 still bypasses it.)
    if grep -q '"status":"running"' "$STATUS" 2>/dev/null; then
        set_status "error" "Interrupted unexpectedly - check network and retry"
    fi
    rm -f "$LOCK"
}

# -- Keep list: carry the Tailscale binary across a firmware upgrade only while it is ours --
#
# A firmware upgrade that keeps settings copies every path a /lib/upgrade/keep.d list names that
# exists, so a list naming the binaries carries the old firmware's own Tailscale over the new
# firmware's (measured on a 4.8.5 → 4.9.0 upgrade). The static list no longer names them; KEEP_BIN
# does, and exists only while a Version Manager binary is installed: written on install, removed on
# Restore. It names itself too, so it survives the upgrade it governs and a second upgrade still
# keeps the binary. It is written to a temp file in the same directory and renamed, so sysupgrade
# never reads a half-written list. The temp name starts with a dot, which sysupgrade's
# /lib/upgrade/keep.d/* glob does not match, so one left behind by a power cut lists nothing.
# Both functions log and return 1 on failure; callers carry on, since the binary itself is fine.

keep_write() {
    local tmp="${KEEP_BIN%/*}/.${KEEP_BIN##*/}.tmp.$$"
    if printf '%s\n' \
        "# Written by /usr/bin/ts-fix-update when the Version Manager installed this Tailscale binary;" \
        "# deleted on Restore." \
        "$TS_DAEMON" "$TS_BIN" "$KEEP_BIN" 2>/dev/null > "$tmp" &&
       mv -f "$tmp" "$KEEP_BIN" 2>/dev/null; then
        return 0
    fi
    rm -f "$tmp" 2>/dev/null
    logger -t ts-fix "ts-fix-update: could not write $KEEP_BIN - this Tailscale binary will not be kept across a firmware upgrade"
    return 1
}

keep_remove() {
    rm -f "$KEEP_BIN" 2>/dev/null && return 0
    logger -t ts-fix "ts-fix-update: could not remove $KEEP_BIN - a firmware upgrade will still keep the installed Tailscale binary"
    return 1
}

# Put a downloaded Version Manager binary in place — the combined binary as tailscaled, tailscale a
# symlink to it — and list both for keeping across a firmware upgrade.
install_binary() {
    rm -f "$TS_BIN" "$TS_DAEMON"
    mv "$1" "$TS_DAEMON"
    chmod 755 "$TS_DAEMON"
    ln -sf tailscaled "$TS_BIN"
    keep_write || true
}

# check_download <file>: return if <file> is ELF with the byte order of REF_ELF; otherwise delete
# it, set an error status and exit 1, before anything installed is touched. Only the byte order is
# compared: the kernel's ELF loader refuses a binary in the other order, and uname cannot tell the
# order on MIPS. A binary that cannot run for another reason is left to the version check after
# install. A REF_ELF that cannot be read as ELF fails the check rather than skipping it.
check_download() {
    local want
    want=$(elf_order "$REF_ELF")
    if [ -n "$want" ] && [ "$(elf_order "$1")" = "$want" ]; then
        return 0
    fi
    rm -f "$1"
    set_status "error" "Downloaded binary does not match this router - nothing was changed"
    exit 1
}

# Put the factory binaries from ROM_PREFIX back and restart Tailscale: used by Restore and by the
# rollback of an install whose new binary prints no version. Callers check the factory tailscaled
# exists.
restore_factory() {
    # Stop tailscale
    "$TS_INIT" stop 2>/dev/null || true
    sleep 1

    # Restore from /rom/ (factory has tailscale as symlink to tailscaled —
    # cp -a preserves symlinks, so this recreates the factory layout)
    rm -f "$TS_BIN" "$TS_DAEMON"
    cp -a "${ROM_PREFIX}${TS_BIN}" "$TS_BIN"
    cp -a "${ROM_PREFIX}${TS_DAEMON}" "$TS_DAEMON"
    chmod 755 "$TS_DAEMON"

    # The restored binaries equal the firmware's, so they must not be kept across a firmware
    # upgrade: the next firmware brings its own. Stop listing them.
    keep_remove || true

    # Clean up stale sysupgrade.conf entries (v1.0.18+ uses keep.d)
    if [ -f "$SYSUPGRADE_CONF" ]; then
        sed -i "\|^${TS_BIN}$|d" "$SYSUPGRADE_CONF" 2>/dev/null
        sed -i "\|^${TS_DAEMON}$|d" "$SYSUPGRADE_CONF" 2>/dev/null
    fi

    # Restart
    "$TS_INIT" start 2>/dev/null || true
    sleep 3
}

# rollback_install <version>: the binary just installed printed no version, so it is treated as not
# running on this router. Put the factory binaries back, set an error status, exit 1.
rollback_install() {
    if [ ! -f "${ROM_PREFIX}${TS_DAEMON}" ]; then
        set_status "error" "Tailscale $1 did not run on this router and no factory binary was found to restore"
        exit 1
    fi
    set_status "running" "Restoring factory version..."
    # Called with || so set -e does not apply inside: a failed step cannot leave Tailscale stopped
    # halfway through. The comparison then reports whether the factory binaries are back.
    restore_factory || true
    if cmp -s "${ROM_PREFIX}${TS_DAEMON}" "$TS_DAEMON" && cmp -s "${ROM_PREFIX}${TS_BIN}" "$TS_BIN"; then
        set_status "error" "Tailscale $1 did not run on this router - factory version restored"
    else
        set_status "error" "Tailscale $1 did not run on this router and the factory version could not be restored"
    fi
    exit 1
}

# -- Sync-keep mode: converge KEEP_BIN on what is installed (run by postinst) --
#
# Builds before v1.0.22 listed the binaries in the static keep list whatever had installed them.
# The Version Manager installs Admonstrator's builds, whose `tailscale version` first line is the
# full suffixed string (e.g. 1.98.8-tiny.by.admon.1320): keep those. Anything else is the
# firmware's own binary, or a Restore of it, and the next firmware brings its own. Silent, exit 0.
do_sync_keep() {
    local first=""
    if [ -e "$TS_DAEMON" ]; then
        first=$(timeout 10 "$TS_BIN" version 2>/dev/null | head -n 1) || true
    fi
    case "$first" in
        *-tiny.by.admon.*) keep_write || true ;;
        *)                 keep_remove || true ;;
    esac
    return 0
}

# -- Check mode: query latest version and cache it --

do_check() {
    local latest
    # Bounded fetch: -T covers connect/read stalls (GL's wget is uclient-fetch),
    # the outer timeout caps total time — a crawling-but-alive transfer trips
    # neither -T nor a read timeout on its own.
    latest=$(timeout 60 wget -T 30 -qO- "$TINY_URL/version.txt" 2>/dev/null | head -1 | tr -d '\r') || true

    if [ -n "$latest" ]; then
        # Cache the FULL version string (e.g. "1.98.8-tiny.by.admon.1320").
        # Upstream replaces release assets in place under the same base version
        # (the 2026-06-04 ipnbus fix shipped that way), so the build suffix is
        # what distinguishes a fixed rebuild from a buggy install. The RPC
        # compares full strings and derives the display base itself.
        echo "$latest" > "$CACHE"
    fi
}

# -- Check plugin mode: query latest gl-tailscale-fix release from GitHub --

do_check_plugin() {
    local api_response
    api_response=$(timeout 60 wget -T 30 -qO- "https://api.github.com/repos/RemoteToHome-io/gl-tailscale-fix/releases/latest" 2>/dev/null) || true

    if [ -z "$api_response" ]; then
        # Private repo, network error, or rate limit — write empty to indicate checked but unavailable
        echo "" > "$PLUGIN_CACHE"
        return
    fi

    local tag_name release_url
    tag_name=$(echo "$api_response" | jsonfilter -e '@.tag_name' 2>/dev/null)
    release_url=$(echo "$api_response" | jsonfilter -e '@.html_url' 2>/dev/null)

    if [ -n "$tag_name" ]; then
        # Strip leading 'v' prefix (releases tagged as v1.0.11 → 1.0.11)
        tag_name="${tag_name#v}"
        printf '%s\n%s\n' "$tag_name" "$release_url" > "$PLUGIN_CACHE"
    else
        echo "" > "$PLUGIN_CACHE"
    fi
}

# -- Install mode: download and install latest Tailscale --

do_install() {
    exec 200>"$LOCK"
    flock -n 200 || { echo "Update already running"; exit 1; }
    trap 'cleanup; exit 1' TERM INT
    trap cleanup EXIT

    set_status "running" "Detecting architecture..."

    local arch
    arch=$(detect_arch)
    if [ -z "$arch" ]; then
        set_status "error" "Unsupported architecture: $(uname -m)"
        exit 1
    fi

    set_status "running" "Checking latest version..."

    # Get latest version from combined binary releases — FULL string, including
    # the -tiny.by.admon.NNNN build suffix (verified live: version.txt serves
    # the full string)
    local ver_raw latest_ver
    ver_raw=$(timeout 60 wget -T 30 -qO- "$TINY_URL/version.txt" 2>/dev/null | head -1 | tr -d '\r') || true
    if [ -z "$ver_raw" ]; then
        set_status "error" "Failed to check latest version"
        exit 1
    fi

    latest_ver=$(base_ver "$ver_raw")
    if [ -z "$latest_ver" ]; then
        set_status "error" "Could not determine latest version"
        exit 1
    fi

    # Cache it (full string — see do_check)
    echo "$ver_raw" > "$CACHE"

    # Check current version — FULL-string compare. A base-version compare
    # misses in-place rebuilds (same base, new build suffix): after the
    # upstream ipnbus fix on 2026-06-04, buggy and fixed binaries were both
    # "1.98.5" by base and stuck routers reported "Already at latest" forever.
    local current_full
    current_full=$($TS_BIN version 2>/dev/null | head -1 | awk '{print $1}') || true

    if [ -n "$current_full" ] && [ "$current_full" = "$ver_raw" ]; then
        set_status "success" "Already at latest version ($ver_raw)"
        exit 0
    fi

    set_status "running" "Checking disk space..."

    # Check free space where the binary will live: refuse below 5 MB. The download goes to /tmp;
    # the binary is ~6 MB (see the download step), so this floor alone does not guarantee room.
    local free_kb
    free_kb=$(df /usr/sbin/ | tail -1 | awk '{print $4}')
    if [ "$free_kb" -lt 5120 ]; then
        set_status "error" "Not enough disk space (need 5MB, have ${free_kb}KB)"
        exit 1
    fi

    set_status "running" "Downloading Tailscale ${latest_ver}..."

    # Download combined multi-call binary
    local binary="tailscaled-linux-${arch}"
    local url="$TINY_URL/${binary}"
    local tmpfile="/tmp/$binary"

    rm -f "$tmpfile"
    # Bounded download: -T catches connect/read stalls, the outer timeout caps
    # total transfer time. A healthy pull is ~6MB in well under a minute; a
    # degraded path that would otherwise crawl indefinitely dies here with a
    # clean error instead of leaving the UI spinner stuck (observed 2026-07-05).
    if ! timeout 300 wget -T 30 -qO "$tmpfile" "$url" 2>/dev/null; then
        rm -f "$tmpfile"
        set_status "error" "Download failed or timed out"
        exit 1
    fi

    # Verify download isn't empty/truncated
    local size
    size=$(wc -c < "$tmpfile" 2>/dev/null || echo 0)
    if [ "$size" -lt 1000000 ]; then
        rm -f "$tmpfile"
        set_status "error" "Download too small (${size} bytes) — may be corrupt"
        exit 1
    fi

    # Refuse a binary this router cannot run while the installed one is still untouched
    check_download "$tmpfile"

    set_status "running" "Installing binaries..."

    # Stop tailscale
    "$TS_INIT" stop 2>/dev/null || true
    sleep 1

    # Install combined binary + symlink. install_binary also writes KEEP_BIN, the keep list that
    # carries this binary across a firmware upgrade. The static keep.d/gl-tailscale-fix list no
    # longer names the binaries (see the Keep list section above).
    install_binary "$tmpfile"

    # Clean up stale sysupgrade.conf entries from pre-v1.0.18 installations.
    if [ -f "$SYSUPGRADE_CONF" ]; then
        sed -i "\|^${TS_BIN}$|d" "$SYSUPGRADE_CONF" 2>/dev/null
        sed -i "\|^${TS_DAEMON}$|d" "$SYSUPGRADE_CONF" 2>/dev/null
    fi

    set_status "running" "Restarting Tailscale..."

    # Restart tailscale
    "$TS_INIT" start 2>/dev/null || true

    # Wait a moment for it to come up
    sleep 3

    local new_ver
    new_ver=$($TS_BIN version 2>/dev/null | head -1 | awk '{print $1}') || true

    # No version: treat the new binary as not running here and put the factory one back
    [ -n "$new_ver" ] || rollback_install "$latest_ver"

    set_status "success" "Updated to ${new_ver}"
}

# -- Restore mode: restore factory binaries --

do_restore() {
    exec 200>"$LOCK"
    flock -n 200 || { echo "Operation already running"; exit 1; }
    trap 'cleanup; exit 1' TERM INT
    trap cleanup EXIT

    set_status "running" "Restoring factory binaries..."

    if [ ! -f "${ROM_PREFIX}${TS_DAEMON}" ]; then
        set_status "error" "Factory binary not found: ${ROM_PREFIX}${TS_DAEMON}"
        exit 1
    fi

    restore_factory

    local ver
    ver=$($TS_BIN version 2>/dev/null | head -1 | awk '{print $1}')

    set_status "success" "Restored to factory version (${ver:-unknown})"
}

# -- Main --

# Library guard: tests/unit/test-keep-binary.sh and tests/unit/test-arch-select.sh source this file
# with TS_FIX_UPDATE_LIB=1 to get the functions above without running a mode. Never set in
# production.
[ "${TS_FIX_UPDATE_LIB:-0}" = "1" ] && return 0

case "$1" in
    --check)         do_check ;;
    --check-plugin)  do_check_plugin ;;
    --install)       do_install ;;
    --restore)       do_restore ;;
    --sync-keep)     do_sync_keep ;;
    *)
        echo "Usage: ts-fix-update [--check|--check-plugin|--install|--restore|--sync-keep]"
        echo "  --check         Check for latest Tailscale version (writes to $CACHE)"
        echo "  --check-plugin  Check for latest gl-tailscale-fix release from GitHub"
        echo "  --install       Download and install latest Tailscale"
        echo "  --restore       Restore factory Tailscale binaries from /rom/"
        echo "  --sync-keep     Keep the installed Tailscale across firmware upgrades only if the"
        echo "                  Version Manager installed it (writes or removes $KEEP_BIN)"
        exit 1
        ;;
esac
