#!/bin/sh
# gl-tailscale-fix: Re-apply settings after GL's "tailscale up --reset"
# Called by procd reload trigger (uci commit tailscale) and hotplug (ifup).
# Waits for GL's gl_tailscale restart to finish, then re-applies exit node,
# guest routes, firewall forwardings, and the two-layer kill switch (owned
# entirely by /usr/bin/ts-fix-ks).
#
# Pending-flag contract: when tailscaled is not Running within the wait below the daemon-level half
# is skipped and /tmp/ts-fix-daemon-pending is left behind as the watchdog's retry signal, and any
# pass that does apply those settings — or that tears everything down — removes it again. A pass
# whose Route Guest read of the advertised routes fails leaves it behind too (see there).
#
# Every call into the tailscale CLI below runs under `timeout 10`: the watchdog runs this script
# synchronously, so one hung call would stall every kill-switch backstop behind it. A `tailscale
# set` that fails is logged; a read that fails or times out prints nothing, and each read's caller
# treats that as it treats the daemon being down. tests/unit/test-ks-armdisarm.sh (case TS) fails
# on an unbounded call.
# Copyright (c) 2026 RemoteToHome Consulting (https://remotetohome.io)
# https://github.com/RemoteToHome-io/gl-tailscale-fix

# `timeout` ships in ROM on GL 4.8.4, 4.9.0 and 4.11. Where it is missing, run the command
# unbounded as before rather than not at all: without it every bounded call would fail with 127.
command -v timeout >/dev/null 2>&1 || timeout() { shift; "$@"; }

# Firmware detection — on GL 4.9+, some features overlap with GL's native
# Tailscale enhancements. We keep the plugin fully active (kill switch, guest
# routing, SSH, Version Manager, masquerade) but skip operations that would
# fight GL's native layer (specifically: tailscale set --advertise-exit-node,
# which GL manages via run_exit_node UCI on 4.9+).
is_fw49_plus() {
    local fw_ver major minor
    fw_ver=$(awk '{print $1}' /etc/glversion 2>/dev/null)
    [ -z "$fw_ver" ] && return 1  # non-GL firmware — treat as < 4.9
    major=$(echo "$fw_ver" | cut -d. -f1)
    minor=$(echo "$fw_ver" | cut -d. -f2)
    if [ "$major" -gt 4 ] 2>/dev/null || \
       { [ "$major" -eq 4 ] && [ "$minor" -ge 9 ]; } 2>/dev/null; then
        return 0
    fi
    return 1
}

# Find the firewall zone section whose .name='wan'. Stock GL configs use
# anonymous sections (e.g. @zone[1]) so we iterate to locate it. Echoes
# the section name (e.g. "@zone[1]" or "cfg033f8e") on success, nothing
# on failure (caller treats empty as "no wan zone, skip").
find_wan_zone_section() {
    local s
    for s in $(uci -q show firewall 2>/dev/null | grep "=zone$" | cut -d= -f1 | sed 's/^firewall\.//'); do
        if [ "$(uci -q get firewall.$s.name 2>/dev/null)" = "wan" ]; then
            echo "$s"
            return 0
        fi
    done
    return 1
}

# Ensure wan-zone IPv6 masquerade when this router is acting as a Tailscale
# exit node. Closes the pre-4.9 fw3 gap: Tailscale's own v6 SNAT chain is
# empty on iptables/fw3 (verified empirically) AND pre-4.9 GL firmware
# doesn't reliably set wan.masq6. Without it, forwarded tailnet IPv6 exits
# with the Tailscale ULA source intact and is dropped upstream — silent
# IPv6 failure for tailnet clients trying to use this router as exit node.
# Idempotent. Sidecar flag ts-fix.settings.wan_masq6_set_by_plugin tracks
# whether WE set masq6, so teardown only unsets it if our flag is on —
# never trampling a GL- or user-managed value.
#
# Distinguishes "option not present" (cur empty) from "user explicit 0"
# (cur="0"). Only sets when truly unset; teardown uses `uci -q delete`
# instead of setting 0, so we don't fabricate a value that wasn't there.
# If user explicitly overrides our 1→0 after we set it, we release
# ownership (clear our flag) and respect their 0. Red-team 2026-05-23.
#
#   $1: "1" to ensure on, "0" to (conditionally) restore
ensure_wan_v6_masq_for_exit_node() {
    local on=$1 wan_sec cur flag changed=0
    wan_sec=$(find_wan_zone_section)
    [ -z "$wan_sec" ] && return 0
    cur=$(uci -q get "firewall.$wan_sec.masq6")
    flag=$(uci -q get ts-fix.settings.wan_masq6_set_by_plugin)
    if [ "$on" = "1" ]; then
        if [ -z "$cur" ]; then
            # masq6 truly unset → safe to set (user hasn't expressed intent)
            uci set "firewall.$wan_sec.masq6=1"
            uci set ts-fix.settings.wan_masq6_set_by_plugin=1
            changed=1
        elif [ "$cur" = "0" ] && [ "$flag" = "1" ]; then
            # User explicitly set masq6=0 after we set it to 1. Respect the
            # override: release ownership (clear our flag), leave their 0.
            uci set ts-fix.settings.wan_masq6_set_by_plugin=0
            changed=1
        fi
        # cur="0" with flag=0: user/GL chose 0, don't reclaim.
        # cur="1": no-op regardless of flag.
    else
        if [ "$flag" = "1" ]; then
            # We previously set it. Delete the option (back to unset state)
            # rather than setting "0" — preserves the distinction between
            # "user explicitly 0" and "option not present".
            uci -q delete "firewall.$wan_sec.masq6"
            uci set ts-fix.settings.wan_masq6_set_by_plugin=0
            changed=1
        fi
    fi
    if [ "$changed" = "1" ]; then
        uci commit firewall
        uci commit ts-fix
        /etc/init.d/firewall reload >/dev/null 2>&1
    fi
}

# Strip Tailscale tailnet tokens out of a dnsmasq "domain" value.
#
# GL writes the tailnet MagicDNS suffix into dhcp.@dnsmasq[0].domain, which dnsmasq then
# advertises to LAN clients. 4.8 APPENDS it ("<suffix> <original>"); 4.9 REPLACES the value
# outright ("<suffix>"). This removes any tailnet token from either shape and echoes the
# remainder, which may legitimately be empty (the 4.9 case — the caller falls back).
#
# Matches a bare "ts.net" as well as "*.ts.net": gl_tailscale falls back to dns_suffix="ts.net"
# when the daemon returns no MagicDNS suffix, and a suffix-only match would silently leave the
# fingerprint in place in exactly that degraded case.
#
# The case arms are anchored so a lookalike ("notts.net", "ts.net.example.com") is preserved.
# Unit-tested by tests/unit/test-domain-clean.sh — keep the markers intact, it extracts them.
# ---8<--- ts_domain_clean (unit-tested by tests/unit/test-domain-clean.sh) ---8<---
ts_domain_clean() {
    local out="" tok
    for tok in $1; do
        case "$tok" in
            ts.net|*.ts.net) ;;
            *) out="${out:+$out }$tok" ;;
        esac
    done
    echo "$out"
}
# ---8<--- end ts_domain_clean ---8<---

# Guest network helper for Route Guest.
#
# guest_net echoes br-guest's IPv4 network as NETWORK/PREFIX, or nothing when br-guest has no IPv4
# address or ipcalc fails. The network comes from ipcalc.sh, the tool GL's own script relies on to
# build its "from <guest net>" rule, never from zeroing the last octet: that is right only for a
# /24. 192.168.9.1/23 is network 192.168.8.0/23, and 192.168.9.0/23 would miss GL's rule in
# the swap below and advertise a route that is not a network address. Only the first IPv4 address
# is read, as the RPC reads it, and only one of the form a.b.c.d/N is handed to ipcalc: for an
# empty or prefix-less argument ipcalc answers 0.0.0.0/0, which must never reach the code below.
#
# IPCALC exists so tests/unit/test-guest-net.sh can substitute a fake; nothing else sets it.
# ---8<--- guest_net (unit-tested by tests/unit/test-guest-net.sh) ---8<---
IPCALC=${IPCALC:-/bin/ipcalc.sh}

guest_net() {
    local addr out
    addr=$(ip -4 addr show br-guest 2>/dev/null |
        awk '$1 == "inet" && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/ { print $2; exit }')
    [ -n "$addr" ] || return 0
    out=$("$IPCALC" "$addr" 2>/dev/null) || return 0
    printf '%s\n' "$out" | awk -F= '
        $1 == "NETWORK" { n = $2 }
        $1 == "PREFIX" { p = $2 }
        END { if (n ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && p ~ /^[0-9]+$/) print n "/" p }'
}
# ---8<--- end guest_net ---8<---

# IoT network helper for Route IoT.
#
# iot_net echoes br-iot's IPv4 network as NETWORK/PREFIX, or nothing when br-iot has no IPv4
# address or ipcalc fails. The network comes from ipcalc.sh, the tool GL's own script relies on to
# build its "from <iot net>" rule, never from zeroing the last octet: that is right only for a
# /24. 192.168.10.1/23 is network 192.168.10.0/23, and 192.168.10.0/23 would miss GL's rule in
# the swap below and advertise a route that is not a network address. Only the first IPv4 address
# is read, as the RPC reads it, and only one of the form a.b.c.d/N is handed to ipcalc: for an
# empty or prefix-less argument ipcalc answers 0.0.0.0/0, which must never reach the code below.
# br-iot is absent on firmware without the IoT network (created since 4.9.0, disabled by default),
# and this echoes nothing then.
#
# IPCALC exists so tests/unit/test-iot-net.sh can substitute a fake; nothing else sets it.
#
# This block carries its own markers because prerm evals it on its own; IPCALC is defaulted again
# here so the block stands alone.
# ---8<--- iot_net (unit-tested by tests/unit/test-iot-net.sh) ---8<---
IPCALC=${IPCALC:-/bin/ipcalc.sh}

iot_net() {
    local addr out
    addr=$(ip -4 addr show br-iot 2>/dev/null |
        awk '$1 == "inet" && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/ { print $2; exit }')
    [ -n "$addr" ] || return 0
    out=$("$IPCALC" "$addr" 2>/dev/null) || return 0
    printf '%s\n' "$out" | awk -F= '
        $1 == "NETWORK" { n = $2 }
        $1 == "PREFIX" { p = $2 }
        END { if (n ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && p ~ /^[0-9]+$/) print n "/" p }'
}
# ---8<--- end iot_net ---8<---

# route_list_drop echoes the comma-separated route list $1 without the entry $2, comparing whole
# entries as strings. Removal used to run sed with the subnet inside the program, where its "/"
# ended the s command — sed failed, and its empty output took the --advertise-routes= branch — and
# its dots would have matched any character.
#
# Shared: Route Guest and Route IoT both remove a subnet this way, so it is kept in its own block
# rather than in either network's helper block. Its cases live in tests/unit/test-guest-net.sh,
# where they already were; the Route IoT advertisement block only calls it.
# ---8<--- route_list_drop (unit-tested by tests/unit/test-guest-net.sh) ---8<---
route_list_drop() {
    local out="" r
    for r in $(printf '%s\n' "$1" | tr ',' ' '); do
        [ "$r" = "$2" ] || out="${out:+$out,}$r"
    done
    printf '%s\n' "$out"
}
# ---8<--- end route_list_drop ---8<---

# ---8<--- ts_state
# The kill switch's intent, read as the engine reads it (_ks_intent in /usr/bin/ts-fix-ks). This
# block is byte-identical in ts-fix-watchdog, ts-fix-reapply, hotplug 20-ts-fix and postinst;
# tests/unit/test-ts-state.sh holds the copies to that, and to the engine's meaning.
#
# `uci -q get` prints nothing and returns 1 both for an absent option and for a read that failed,
# so it cannot tell "off" from "unknown", and a failed read taken for "off" tears protection down.
# `uci -q show <pkg>.settings` can: a readable section prints its own "<pkg>.settings=<type>" line
# first, and a failed read prints nothing. An option absent from a readable section is off (GL's
# slider accessory deletes tailscale.settings.enabled to restore its never-set state); a failed read
# is UNKNOWN, and no caller may act on it as off. Shell matching only: no fork beyond the uci call.
#
# ts_state — tailscale.settings, read once: ts_en is 1 when it holds enabled='1', 0 for any other
# value or none, and EMPTY when the read failed (rc 1); ts_eip is exit_node_ip's value, empty when
# absent, and means something only when ts_en is not empty. uci prints the value single-quoted, and
# an address holds no quote of its own, so the outer pair is all there is to strip.
ts_state() {
    local out nl='
'
    ts_en=""
    ts_eip=""
    out=$(uci -q show tailscale.settings 2>/dev/null)
    case "$out" in
        "tailscale.settings="*) ;;
        *) return 1 ;;
    esac
    ts_en=0
    case "$out$nl" in
        *"${nl}tailscale.settings.enabled='1'$nl"*) ts_en=1 ;;
    esac
    case "$out" in
        *"${nl}tailscale.settings.exit_node_ip="*)
            ts_eip=${out#*"${nl}tailscale.settings.exit_node_ip="}
            ts_eip=${ts_eip%%"$nl"*}
            ts_eip=${ts_eip#\'}
            ts_eip=${ts_eip%\'}
            ;;
    esac
    return 0
}

# ks_state — ts-fix.settings, read once: ks_on is 1 when it holds kill_switch='1', 0 for any other
# value or none, and EMPTY when the read failed (rc 1).
ks_state() {
    local out nl='
'
    ks_on=""
    out=$(uci -q show ts-fix.settings 2>/dev/null)
    case "$out" in
        "ts-fix.settings="*) ;;
        *) return 1 ;;
    esac
    ks_on=0
    case "$out$nl" in
        *"${nl}ts-fix.settings.kill_switch='1'$nl"*) ks_on=1 ;;
    esac
    return 0
}
# ---8<--- end ts_state

# One read of tailscale.settings (ts_state, above). A read that failed is UNKNOWN, never "disabled":
# taken for a disable it used to run the teardown below, which commits kill_switch=0 — a failed read
# turned into a durable disarm. Nothing is done on it, and rc 1 says so; the watchdog's next poll
# runs this again.
ts_state
if [ -z "$ts_en" ]; then
    logger -t ts-fix "ERROR reapply: tailscale.settings could not be read - nothing done (no teardown, no re-apply); the watchdog retries"
    exit 1
fi

# If Tailscale is disabled — enabled '0', or the option absent, as GL's slider leaves it — tear
# down all ts-fix state and exit.
# This covers the case where a user disables Tailscale while our switches
# are active — the kill switch, firewall forwardings, and policy routes must
# be cleaned up, and UCI settings reset to 0 so everything starts clean
# when Tailscale is re-enabled.
if [ "$ts_en" = "0" ]; then
    # Hand the kill switch back to its engine: it re-enables exactly the forwardings we severed and
    # clears any RPDB-era rules an older install left behind. A failure here leaves LAN/guest/IoT
    # egress severed, so say so loudly — the UCI reset below must not read as "all clean".
    /usr/bin/ts-fix-ks disarm || logger -t ts-fix "teardown: ts-fix-ks disarm reported failure (rc $?) - severed state may need a manual ts-fix-ks disarm"

    # Remove guest policy route fixup
    _gs=$(guest_net)
    [ -n "$_gs" ] && ip rule del to "$_gs" table main 2>/dev/null

    # Remove IoT policy route fixup
    _iot=$(iot_net)
    [ -n "$_iot" ] && ip rule del to "$_iot" table main 2>/dev/null

    # Remove guest subnet from advertised routes (pgrep guard — avoids
    # spawning ~60MB Go process if daemon already stopped during disable)
    if [ -n "$_gs" ] && pgrep tailscaled >/dev/null 2>&1; then
        _cur=$(timeout 10 /usr/sbin/tailscale debug prefs 2>/dev/null | jsonfilter -e '@.AdvertiseRoutes[*]' 2>/dev/null | tr '\n' ',')
        case ",$_cur," in
            *",$_gs,"*)
                _new=$(route_list_drop "$_cur" "$_gs")
                if [ -n "$_new" ]; then
                    timeout 10 /usr/sbin/tailscale set --advertise-routes="$_new" 2>/dev/null || \
                        logger -t ts-fix "teardown: tailscale set --advertise-routes failed or timed out (rc $?) - the guest subnet may still be advertised"
                else
                    timeout 10 /usr/sbin/tailscale set --advertise-routes= 2>/dev/null || \
                        logger -t ts-fix "teardown: tailscale set --advertise-routes= failed or timed out (rc $?) - the guest subnet may still be advertised"
                fi
                ;;
        esac
    fi

    # Remove IoT subnet from advertised routes (pgrep guard — avoids
    # spawning ~60MB Go process if daemon already stopped during disable)
    if [ -n "$_iot" ] && pgrep tailscaled >/dev/null 2>&1; then
        _cur=$(timeout 10 /usr/sbin/tailscale debug prefs 2>/dev/null | jsonfilter -e '@.AdvertiseRoutes[*]' 2>/dev/null | tr '\n' ',')
        case ",$_cur," in
            *",$_iot,"*)
                _new=$(route_list_drop "$_cur" "$_iot")
                if [ -n "$_new" ]; then
                    timeout 10 /usr/sbin/tailscale set --advertise-routes="$_new" 2>/dev/null || \
                        logger -t ts-fix "route iot off: tailscale set --advertise-routes failed or timed out (rc $?) - the IoT subnet may still be advertised"
                else
                    timeout 10 /usr/sbin/tailscale set --advertise-routes= 2>/dev/null || \
                        logger -t ts-fix "route iot off: tailscale set --advertise-routes= failed or timed out (rc $?) - the IoT subnet may still be advertised"
                fi
                ;;
        esac
    fi

    # Remove legacy UCI firewall kill switch rules (pre-v1.0.9)
    for section in ts_ks_lan2wan ts_ks_guest2wan; do
        uci -q delete firewall.$section 2>/dev/null
    done

    # Remove guest<->tailscale and iot<->tailscale firewall forwardings and masquerade
    _fw=0
    [ -n "$(uci -q get firewall.ts_fix_guest2ts)" ] && {
        uci -q delete firewall.ts_fix_guest2ts
        uci -q delete firewall.ts_fix_ts2guest
        _fw=1
    }
    [ -n "$(uci -q get firewall.ts_fix_iot2ts)" ] && {
        uci -q delete firewall.ts_fix_iot2ts
        uci -q delete firewall.ts_fix_ts2iot
        _fw=1
    }
    # masq6 (IPv6) is plugin-owned on ALL firmware (GL never sets it), so clear
    # it here regardless of firmware. masq (IPv4) is GL's on 4.9+ — only clear
    # it pre-4.9 (deleting on 4.9 would trample GL's state).
    if [ "$(uci -q get firewall.tailscale0.masq6)" = "1" ]; then
        uci -q delete firewall.tailscale0.masq6
        _fw=1
    fi
    if ! is_fw49_plus && [ "$(uci -q get firewall.tailscale0.masq)" = "1" ]; then
        uci -q delete firewall.tailscale0.masq
        _fw=1
    fi
    [ "$_fw" = "1" ] && { uci commit firewall; /etc/init.d/firewall reload; }

    # If we set wan.masq6 for exit-node-server, restore it. Idempotent no-op
    # unless our sidecar flag is set, so we never trample a GL/user value.
    ensure_wan_v6_masq_for_exit_node 0

    # Disable Tailscale SSH (pgrep guard — avoids spawning Go process if daemon already stopped)
    if pgrep tailscaled >/dev/null 2>&1; then
        timeout 10 /usr/sbin/tailscale set --ssh=false 2>/dev/null || \
            logger -t ts-fix "teardown: tailscale set --ssh=false failed or timed out (rc $?) - Tailscale SSH may still be on"
    fi

    # Stop owning the dnsmasq advertised domain. We deliberately do NOT write the tailnet
    # suffix back — GL restores the user's original itself on its own disable path, and it
    # re-asserts the suffix on the next enable. Clearing user_domain means a later re-enable
    # re-derives from whatever the user's value is then, rather than resurrecting a stale one.
    #
    # hide_ts_domain itself is NOT reset: it is a persistent preference describing what should
    # be advertised whenever Tailscale is on, so it survives disable/enable cycles — same
    # treatment as ks_follow_exit_node.
    uci -q delete ts-fix.settings.user_domain

    # Reset all ts-fix UCI settings to 0
    uci -q set ts-fix.settings.kill_switch=0
    uci -q set ts-fix.settings.route_guest=0
    uci -q set ts-fix.settings.route_iot=0
    uci -q set ts-fix.settings.advertise_exit_node=0
    uci -q set ts-fix.settings.tailscale_ssh=0
    uci commit ts-fix

    # Nothing can be pending once every setting is torn down and intent is back to 0.
    rm -f /tmp/ts-fix-daemon-pending 2>/dev/null

    exit 0
fi

# Prevent concurrent runs (shared with hotplug and procd trigger)
LOCK="/tmp/ts-fix-reapply.lock"
exec 200>"$LOCK"
flock -n 200 || exit 0

# Kill switch (two layers). ALL kill-switch logic lives in /usr/bin/ts-fix-ks — this block only
# expresses intent and calls it, and no other component may touch zone, rule or severed state
# directly. The zone layer: the engine severs every lan/guest/iot -> uplink-class firewall
# forwarding, recording each as a src:dest pair in the ts-fix.settings.ks_severed sidecar so a
# disarm restores exactly what we disabled, and ensures lan -> tailscale0 so an armed router routes
# through the tunnel instead of going dark. It lives in flash-persisted UCI that the firewall
# re-emits at every lifecycle event and applies at boot before any uplink comes up, with no
# dependency on tailscaled being alive; a firewall restart opens it for a moment. The rule layer:
# the priority-5279 rules in front of an unreachable route in table 100, plus the guest/iot
# source-rule swap. A firewall restart does not touch it; netifd's start (boot, network restart)
# wipes it, and the 10-ts-fix-ks hotplug handler re-installs it at the next non-loopback ifup,
# while the zone layer holds. Each layer survives the other's eraser, so neither a boot-time early
# install nor a flush-reactive guard is needed (the engine's header has the detail).
#
# Design C is unchanged: armed iff the user's kill_switch intent is on AND Tailscale is enabled
# (the teardown above handles a user disable). Nothing reads exit-node state, so the daemon's
# transient or stale ExitNodeID can neither arm nor disarm it — fail-secure: block, never leak the
# real IP. Only a kill_switch=0 toggle or a Tailscale disable takes it down.
#
# kill_switch is read the three-state way (ks_state, above). A read that failed is neither arm nor
# disarm: one ERROR, and the kill switch is left exactly as it is — the engine's own check, on the
# watchdog's next poll, reads intent itself and is the authority. Taking it for "off" used to
# disarm an armed router.
#
# Established flows are carried by masq/masq6 rather than by anything here: on interface death
# masquerade's device-down handler purges its conntrack entries, and on exit-node clear tailscaled's
# own config-change cleanup purges them (device-measured on fw3 2026-08-17; fw4 re-proof is a ship
# gate). Applied HERE, before the daemon waits below, because arming needs no daemon state at all.
ks_state
if [ -z "$ks_on" ]; then
    logger -t ts-fix "ERROR reapply: ts-fix.settings could not be read - kill switch left as it is (neither armed nor disarmed); the engine's check is the authority"
elif [ "$ks_on" = "1" ]; then
    # Neither a mode refusal (rc 2) nor an engine failure (rc 1) may abort this script: the
    # domain, masquerade, exit-node and guest work below is independent of the kill switch and
    # still has to run. The engine has already logged its own reason in both cases; these lines
    # add the caller's context. On rc 1 the kill switch may NOT be effective — the watchdog's
    # check pass is the retry.
    /usr/bin/ts-fix-ks arm
    _ks_rc=$?
    if [ "$_ks_rc" = "2" ]; then
        logger -t ts-fix "kill switch not armed: requires Router mode (glconfig.general.mode) - continuing with remaining reapply work"
    elif [ "$_ks_rc" != "0" ]; then
        logger -t ts-fix "ERROR: ts-fix-ks arm failed (rc $_ks_rc) - kill switch may NOT be effective; engine will retry on watchdog check"
    fi
else
    /usr/bin/ts-fix-ks disarm || logger -t ts-fix "ts-fix-ks disarm reported failure (rc $?)"
fi

# Hide the Tailscale search domain from LAN clients (opt-in, v1.0.22).
#
# GL writes the tailnet MagicDNS suffix into dhcp.@dnsmasq[0].domain, which dnsmasq advertises
# to DHCP clients — so every LAN device, including a corporate-managed laptop, receives
# "<tailnet>.ts.net" as its domain/search suffix. That is a passive signal that the machine sits
# behind a Tailscale node. It also breaks local .lan resolution on 4.9, where GL REPLACES the
# value rather than appending to it (expandhosts then qualifies hostnames into the tailnet
# domain instead of the user's).
#
# We take ownership of that one value. /etc/dnsmasq.conf's "server=/…/100.100.100.100" entry is
# deliberately untouched, so an explicit tailnet FQDN still resolves — only the broadcast hint
# goes away. gl_tailscale is the sole writer of this field on both firmwares (verified), so this
# is the only place we have to contest.
#
# REACTIVE, never authoritative: we only ever strip a tailnet token, never impose a remembered
# value over one the user has since chosen. Enforcing a value cached at first-enable would fight
# a user who later edited their local domain in LuCI — we would keep writing the old one back
# over their edit. user_domain is therefore a fallback for the 4.9 replace case only, and it is
# refreshed from whatever clean value the user currently has.
#
# Applied here, before the daemon waits below, because it needs no daemon state at all.
hide_ts_domain=$(uci -q get ts-fix.settings.hide_ts_domain)
if [ "$hide_ts_domain" = "1" ]; then
    cur_domain=$(uci -q get "dhcp.@dnsmasq[0].domain")
    want=$(ts_domain_clean "$cur_domain")
    if [ "$want" = "$cur_domain" ]; then
        # No tailnet token present — nothing to do. Adopt the current value as the user's
        # domain so that when GL next writes the suffix, we restore what they actually chose.
        if [ -n "$cur_domain" ] && \
           [ "$(uci -q get ts-fix.settings.user_domain)" != "$cur_domain" ]; then
            uci set ts-fix.settings.user_domain="$cur_domain"
            uci commit ts-fix
        fi
    else
        # A tailnet token was present. If stripping leaves nothing, this is the 4.9 replace
        # case — fall back to our recorded value, then GL's own saved sidecar, then "lan".
        if [ -z "$want" ]; then
            want=$(uci -q get ts-fix.settings.user_domain)
            [ -z "$want" ] && want=$(uci -q get tailscale.settings.original_domain)
            [ -z "$want" ] && want="lan"
        fi
        logger -t ts-fix "hiding tailnet search domain: dnsmasq domain '$cur_domain' -> '$want'"
        uci set "dhcp.@dnsmasq[0].domain=$want"
        uci commit dhcp
        uci set ts-fix.settings.user_domain="$want"
        uci commit ts-fix
        /etc/init.d/dnsmasq restart >/dev/null 2>&1
    fi
fi

# Ensure tailscale0 zone masquerade BEFORE waiting for tailscaled — a pure
# firewall setting that doesn't need the daemon. Required for LAN clients to
# reach Tailscale peers / the exit node (SNAT return path).
#   IPv4 (masq):  GL owns it on 4.9+ (its "IP Masquerading" toggle sets masq),
#                 so we set it only pre-4.9 to avoid fighting the UI.
#   IPv6 (masq6): GL NEVER sets tailscale0.masq6 on ANY firmware — its toggle
#                 is IPv4-only (verified: no masq6 in /etc/firewall.tailscale.sh).
#                 Without masq6, forwarded LAN IPv6 can't traverse the exit-node
#                 tunnel, so the plugin sets it on all firmware — no GL state to
#                 defer to.
if [ -n "$(uci -q get firewall.tailscale0)" ]; then
    _fwchg=0
    if [ "$(uci -q get firewall.tailscale0.masq6)" != "1" ]; then
        uci set firewall.tailscale0.masq6=1; _fwchg=1
    fi
    if ! is_fw49_plus && [ "$(uci -q get firewall.tailscale0.masq)" != "1" ]; then
        uci set firewall.tailscale0.masq=1; _fwchg=1
    fi
    [ "$_fwchg" = "1" ] && { uci commit firewall; /etc/init.d/firewall reload >/dev/null 2>&1; }
fi

# Migration: remove legacy UCI firewall kill switch rules (pre-v1.0.9)
for section in ts_ks_lan2wan ts_ks_guest2wan; do
    [ -n "$(uci -q get firewall.$section)" ] && {
        uci -q delete firewall.$section
        uci commit firewall
    }
done

# GL's 19-tailscale-iface calls "gl_tailscale restart &" (async).
# That script does: tailscale restart -> network setup -> tailscale up --reset.
# We MUST wait for gl_tailscale to finish, otherwise --reset clears our settings.

# Wait for gl_tailscale to start (brief delay so the bg process appears)
sleep 3

# Wait for gl_tailscale to finish (up to 60s)
i=0
while [ $i -lt 60 ]; do
    pgrep -f "gl_tailscale restart" >/dev/null 2>&1 || break
    sleep 1
    i=$((i + 1))
done

# GL's chain re-adds its guest/iot "from <net> lookup main" rule at its very end, after its firewall
# restart, and that rule routes guest/iot traffic past the kill switch's priority-5279 rules until
# the engine swaps it out again. The watchdog's next pass cannot be counted on for that: it may be
# parked in this very script. So re-assert the rule layer now, within about a second of the chain
# ending. rules-ensure takes no lock and self-gates on armed intent and Router mode, so on a
# disarmed router it is a no-op.
/usr/bin/ts-fix-ks rules-ensure </dev/null

# Now wait for Running state (up to 30 tries a second apart; a status call that hangs is cut off
# after 10s and reads as not Running, as a dead daemon does)
# pgrep guard avoids spawning ~60MB Go CLI while daemon is still starting
i=0
state=""
while [ $i -lt 30 ]; do
    if pgrep tailscaled >/dev/null 2>&1; then
        state=$(timeout 10 /usr/sbin/tailscale status --json 2>/dev/null | jsonfilter -e '@.BackendState' 2>/dev/null)
        [ "$state" = "Running" ] && break
    fi
    sleep 1
    i=$((i + 1))
done
# A cold boot can push Running past this wait — a modem still booting behind the router, or a
# clock with no RTC delaying NTP and therefore the control-plane TLS handshake. Every other boot
# ifup event is swallowed by the flock above while this run holds it, so this is the ONLY pass
# that would have applied the daemon-level settings. Record that they are still pending instead of
# exiting silently: the watchdog retries from the flag once the daemon reaches Running, which is
# what keeps an exit-node advertisement from staying lost until the user's next manual Apply.
if [ "$state" != "Running" ]; then
    logger -t ts-fix "tailscaled not Running within wait - daemon-level settings (exit-node advert, SSH, routes) pending; watchdog will retry when Running"
    touch /tmp/ts-fix-daemon-pending 2>/dev/null
    exit 0
fi

# Re-apply exit node advertisement (skip false — already cleared by --reset).
# On GL 4.9+, skip entirely — GL manages this natively via run_exit_node UCI.
adv=$(uci -q get ts-fix.settings.advertise_exit_node)
if [ "$adv" = "1" ] && ! is_fw49_plus; then
    timeout 10 /usr/sbin/tailscale set --advertise-exit-node 2>/dev/null || \
        logger -t ts-fix "tailscale set --advertise-exit-node failed or timed out (rc $?) - exit-node advertisement not re-applied"
fi

# Ensure wan-zone IPv6 masquerade when this router is acting as a Tailscale
# exit node (closes pre-4.9 fw3 gap where Tailscale's own v6 SNAT chain is
# empty + pre-4.9 GL doesn't reliably set wan.masq6). Scoped to pre-4.9 —
# on 4.9+ GL owns the exit-node surface. The "off" branch is a safety net
# that restores wan.masq6 if a previous pre-4.9 install set it and the
# router is no longer acting as exit node (e.g. firmware upgraded to 4.9
# while advertise_exit_node was on; sidecar flag persists in UCI and we
# unwind on the next reapply).
if [ "$adv" = "1" ] && ! is_fw49_plus; then
    ensure_wan_v6_masq_for_exit_node 1
else
    ensure_wan_v6_masq_for_exit_node 0
fi

# Exit-node reconcile: GL's UCI (tailscale.settings.exit_node_ip) is the
# authoritative exit-node intent; push it to the daemon when the two disagree.
# Originally shipped 4.9-gated in v1.0.20 (the bug was mis-attributed to GL's
# 4.9 UI); v1.0.22 drops the firmware gate and adds the CLEAR direction — the
# real cause is binary-side: tiny Tailscale builds with ts_omit_ipnbus (before
# the upstream fix 2026-06-04) let GL's "tailscale up --reset" exit before the
# exit-node dispatch lands, on ANY firmware (reproduced live on 4.8.5, E5800
# control matrix 2026-06-03). Version Manager users run exactly those builds.
#
# Safety: value-snapshot gate. Track `last_seen_exit_node_ip` in our own UCI
# and reconcile only when the user's UCI exit_node_ip CHANGED since our last
# reapply. This (a) avoids touching the daemon on unrelated UCI commits, and
# (b) makes upgrades inert on pre-4.9 routers where an old GL disable left a
# stale exit_node_ip behind — postinst seeds the snapshot to the current value
# so only post-install transitions act (without the seed, the first reapply
# would resurrect a long-dead exit node). The CLEAR direction gets a
# no-snapshot retry path in the watchdog (table-52 check) because the
# upstream failure is intermittent — one push may not land. Both directions
# are capped with timeout: "tailscale set" was observed hanging once on a
# buggy tiny binary, and reapply holds a flock other callers wait on.
# A prefs read that fails or times out leaves ts_exit_id empty. SET then pushes
# the configured exit node, the state it wants either way (a no-op where the
# daemon already has it), and a CLEAR is skipped; the watchdog's table-52 check
# clears a daemon exit node that outlives GL's UCI whatever this read returned.
#
# exit_node_ip is read again here, not taken from the top of the script: GL's chain and the waits
# above can last a minute and more, and the value may have changed. The read is the three-state
# one (ts_state, above): one that failed would leave exit_node_ip empty, which reads as the user
# clearing the exit node — a CLEAR pushed to the daemon, the snapshot moved — so on a failed read
# the reconcile is skipped, with one line, and the snapshot option is left as it is.
ts_state
gl_exit_ip=$ts_eip
ts_exit_id=$(timeout 10 /usr/sbin/tailscale debug prefs 2>/dev/null | jsonfilter -e '@.ExitNodeID' 2>/dev/null)
last_seen=$(uci -q get ts-fix.settings.last_seen_exit_node_ip)
if [ -z "$ts_en" ]; then
    logger -t ts-fix "reconcile: tailscale.settings could not be read - exit-node reconcile skipped, snapshot left at '${last_seen}'"
elif [ "$gl_exit_ip" != "$last_seen" ]; then
    # exit_node_ip value changed since our last reapply. The binary version in
    # the log lines attributes future field reports (tiny builds are the known
    # buggy population); captured only when a reconcile actually fires.
    reconcile_ok=1
    if [ -n "$gl_exit_ip" ] && [ -z "$ts_exit_id" ]; then
        # SET: new non-empty UCI but daemon hasn't caught up → push it.
        bin_ver=$(timeout 10 /usr/sbin/tailscale version 2>/dev/null | head -1)
        logger -t ts-fix "reconcile: UCI exit_node_ip changed to $gl_exit_ip but daemon ExitNodeID empty — running tailscale set --exit-node (binary: ${bin_ver:-unknown})"
        timeout 10 /usr/sbin/tailscale set --exit-node="$gl_exit_ip" 2>/dev/null || reconcile_ok=0
    elif [ -z "$gl_exit_ip" ] && [ -n "$ts_exit_id" ]; then
        # CLEAR: UCI cleared but daemon ExitNodeID stuck → push empty.
        # "tailscale set --exit-node=" clears via the EditPrefs LocalAPI
        # path, which works even on the buggy ipnbus-omitting builds where
        # "up --reset" silently fails (the 2026-06-03 verified workaround).
        bin_ver=$(timeout 10 /usr/sbin/tailscale version 2>/dev/null | head -1)
        logger -t ts-fix "reconcile: UCI exit_node_ip cleared but daemon ExitNodeID stuck — running tailscale set --exit-node= (binary: ${bin_ver:-unknown})"
        timeout 10 /usr/sbin/tailscale set --exit-node= 2>/dev/null || reconcile_ok=0
    fi
    # Advance the snapshot only when the daemon actually matches the UCI intent —
    # either no reconcile was needed, or the one we ran succeeded. Advancing after a
    # FAILED push (timeout, transient daemon error) makes the next reapply see "no
    # change" and never retry, stranding the daemon out of sync with the user's
    # selection until they edit the value again. The SET direction has no other
    # backstop: the watchdog's stuck-state check only covers CLEAR (UCI empty +
    # table-52 default still present), so a dropped SET persists silently — and with
    # the kill switch off, that means traffic keeps egressing the real WAN while the
    # UI shows an exit node selected.
    if [ "$reconcile_ok" = "1" ]; then
        uci set ts-fix.settings.last_seen_exit_node_ip="$gl_exit_ip"
        uci commit ts-fix
    else
        logger -t ts-fix "reconcile: tailscale set failed — leaving snapshot at '${last_seen}' so the next reapply retries"
    fi
fi

# Re-apply Tailscale SSH (skip false — already cleared by --reset)
ts_ssh=$(uci -q get ts-fix.settings.tailscale_ssh)
if [ "$ts_ssh" = "1" ]; then
    timeout 10 /usr/sbin/tailscale set --ssh 2>/dev/null || \
        logger -t ts-fix "tailscale set --ssh failed or timed out (rc $?) - Tailscale SSH not re-applied"
fi

# Re-apply guest subnet route advertisement
route_guest=$(uci -q get ts-fix.settings.route_guest)
guest_subnet=$(guest_net)
# ---8<--- route guest advertise (unit-tested by tests/unit/test-guest-net.sh) ---8<---
routes_unread=0
if [ "$route_guest" = "1" ]; then
    if [ -n "$guest_subnet" ]; then
        # Get current routes, add guest subnet if missing. --advertise-routes REPLACES the whole
        # list, so the routes are read on their own first: a read that fails or times out prints
        # nothing, and nothing must not pass for "no routes" — the add would then drop every other
        # advertised route. Such a pass writes nothing and leaves the daemon-pending flag, as a pass
        # with the daemon down does, so the watchdog retries it.
        if prefs=$(timeout 10 /usr/sbin/tailscale debug prefs 2>/dev/null) && [ -n "$prefs" ]; then
            current=$(printf '%s\n' "$prefs" | jsonfilter -e '@.AdvertiseRoutes[*]' 2>/dev/null | tr '\n' ',')
            case ",$current," in
                *",$guest_subnet,"*) ;; # already present
                *)
                    new_routes="${current}${guest_subnet}"
                    new_routes=$(echo "$new_routes" | sed 's/,$//')
                    timeout 10 /usr/sbin/tailscale set --advertise-routes="$new_routes" 2>/dev/null || \
                        logger -t ts-fix "route guest: tailscale set --advertise-routes failed or timed out (rc $?) - the guest subnet is not advertised"
                    ;;
            esac
        else
            logger -t ts-fix "route guest: tailscale debug prefs failed or timed out - advertised routes unknown, guest subnet not added; pending for the watchdog's retry"
            routes_unread=1
        fi
    fi
else
    # Remove guest subnet from advertised routes if present. A failed read prints nothing, which
    # matches no route, so nothing is written — as with the daemon down.
    if [ -n "$guest_subnet" ]; then
        current=$(timeout 10 /usr/sbin/tailscale debug prefs 2>/dev/null | jsonfilter -e '@.AdvertiseRoutes[*]' 2>/dev/null | tr '\n' ',')
        case ",$current," in
            *",$guest_subnet,"*)
                new_routes=$(route_list_drop "$current" "$guest_subnet")
                if [ -n "$new_routes" ]; then
                    timeout 10 /usr/sbin/tailscale set --advertise-routes="$new_routes" 2>/dev/null || \
                        logger -t ts-fix "route guest off: tailscale set --advertise-routes failed or timed out (rc $?) - the guest subnet may still be advertised"
                else
                    timeout 10 /usr/sbin/tailscale set --advertise-routes= 2>/dev/null || \
                        logger -t ts-fix "route guest off: tailscale set --advertise-routes= failed or timed out (rc $?) - the guest subnet may still be advertised"
                fi
                ;;
        esac
    fi
fi
# ---8<--- end route guest advertise ---8<---

# Re-apply IoT subnet route advertisement
route_iot=$(uci -q get ts-fix.settings.route_iot)
iot_subnet=$(iot_net)
# ---8<--- route iot advertise ---8<---
if [ "$route_iot" = "1" ]; then
    if [ -n "$iot_subnet" ]; then
        # Get current routes, add IoT subnet if missing. --advertise-routes REPLACES the whole
        # list, so the routes are read on their own first: a read that fails or times out prints
        # nothing, and nothing must not pass for "no routes" — the add would then drop every other
        # advertised route. Such a pass writes nothing and leaves the daemon-pending flag, as a
        # pass with the daemon down does, so the watchdog retries it.
        if prefs=$(timeout 10 /usr/sbin/tailscale debug prefs 2>/dev/null) && [ -n "$prefs" ]; then
            current=$(printf '%s\n' "$prefs" | jsonfilter -e '@.AdvertiseRoutes[*]' 2>/dev/null | tr '\n' ',')
            case ",$current," in
                *",$iot_subnet,"*) ;; # already present
                *)
                    new_routes="${current}${iot_subnet}"
                    new_routes=$(echo "$new_routes" | sed 's/,$//')
                    timeout 10 /usr/sbin/tailscale set --advertise-routes="$new_routes" 2>/dev/null || \
                        logger -t ts-fix "route iot: tailscale set --advertise-routes failed or timed out (rc $?) - the IoT subnet is not advertised"
                    ;;
            esac
        else
            logger -t ts-fix "route iot: tailscale debug prefs failed or timed out - advertised routes unknown, IoT subnet not added; pending for the watchdog's retry"
            routes_unread=1
        fi
    fi
else
    # Remove IoT subnet from advertised routes if present. A failed read prints nothing, which
    # matches no route, so nothing is written — as with the daemon down.
    if [ -n "$iot_subnet" ]; then
        current=$(timeout 10 /usr/sbin/tailscale debug prefs 2>/dev/null | jsonfilter -e '@.AdvertiseRoutes[*]' 2>/dev/null | tr '\n' ',')
        case ",$current," in
            *",$iot_subnet,"*)
                new_routes=$(route_list_drop "$current" "$iot_subnet")
                if [ -n "$new_routes" ]; then
                    timeout 10 /usr/sbin/tailscale set --advertise-routes="$new_routes" 2>/dev/null || \
                        logger -t ts-fix "route iot off: tailscale set --advertise-routes failed or timed out (rc $?) - the IoT subnet may still be advertised"
                else
                    timeout 10 /usr/sbin/tailscale set --advertise-routes= 2>/dev/null || \
                        logger -t ts-fix "route iot off: tailscale set --advertise-routes= failed or timed out (rc $?) - the IoT subnet may still be advertised"
                fi
                ;;
        esac
    fi
fi
# ---8<--- end route iot advertise ---8<---

# Fix guest subnet policy route for exit node compatibility.
# GL's gl_tailscale adds "from <guest_subnet> lookup main" at priority 0
# whenever a Custom Exit Node is set and the guest network is enabled. This
# blocks guest clients from using the exit node. Replace with "to
# <guest_subnet>" (destination-based, the shape of GL's own LAN rule).
if [ "$route_guest" = "1" ] && [ -n "$guest_subnet" ]; then
    ip rule del from "$guest_subnet" lookup main 2>/dev/null
    ip rule del to "$guest_subnet" table main 2>/dev/null
    ip rule add to "$guest_subnet" table main priority 0
else
    # Clean up our destination-based rule if present
    _gs=$(guest_net)
    [ -n "$_gs" ] && {
        ip rule del to "$_gs" table main 2>/dev/null
        # That is also the kill switch's own rule: while armed, the engine's source-rule swap keeps
        # exactly this "to <guest net>" rule in place of GL's "from" rule. Put it back at once
        # rather than leave guest-bound traffic to the exit node's table until the next engine
        # pass. rules-ensure takes no lock and self-gates on armed intent and Router mode, so on a
        # disarmed router it is a no-op.
        /usr/bin/ts-fix-ks rules-ensure </dev/null
    }
fi


# Fix IoT subnet policy route for exit node compatibility. GL's gl_tailscale adds
# "from <iot_subnet> lookup main" at priority 0 whenever a Custom Exit Node is set and
# the IoT network is enabled. This blocks IoT clients from using the exit node. Replace
# with "to <iot_subnet>" (destination-based, the shape of GL's own LAN rule).
if [ "$route_iot" = "1" ] && [ -n "$iot_subnet" ]; then
    ip rule del from "$iot_subnet" lookup main 2>/dev/null
    ip rule del to "$iot_subnet" table main 2>/dev/null
    ip rule add to "$iot_subnet" table main priority 0
else
    # Clean up our destination-based rule if present
    _is=$(iot_net)
    [ -n "$_is" ] && {
        ip rule del to "$_is" table main 2>/dev/null
        # That is also the kill switch's own rule: while armed, the engine's source-rule swap keeps
        # exactly this "to <iot net>" rule in place of GL's "from" rule. Put it back at once rather
        # than leave IoT-bound traffic to the exit node's table until the next engine pass.
        # rules-ensure takes no lock and self-gates on armed intent and Router mode, so on a
        # disarmed router it is a no-op.
        /usr/bin/ts-fix-ks rules-ensure </dev/null
    }
fi


# Sync firewall state (batched — single commit + reload at end)
_fw_dirty=0

# Guest routing firewall forwardings
if [ "$route_guest" = "1" ]; then
    if [ -z "$(uci -q get firewall.ts_fix_guest2ts)" ]; then
        uci set firewall.ts_fix_guest2ts=forwarding
        uci set firewall.ts_fix_guest2ts.src=guest
        uci set firewall.ts_fix_guest2ts.dest=tailscale0
        uci set firewall.ts_fix_ts2guest=forwarding
        uci set firewall.ts_fix_ts2guest.src=tailscale0
        uci set firewall.ts_fix_ts2guest.dest=guest
        _fw_dirty=1
    fi
else
    if [ -n "$(uci -q get firewall.ts_fix_guest2ts)" ]; then
        uci -q delete firewall.ts_fix_guest2ts
        uci -q delete firewall.ts_fix_ts2guest
        _fw_dirty=1
    fi
fi

# IoT routing firewall forwardings
if [ "$route_iot" = "1" ]; then
    if [ -z "$(uci -q get firewall.ts_fix_iot2ts)" ]; then
        uci set firewall.ts_fix_iot2ts=forwarding
        uci set firewall.ts_fix_iot2ts.src=iot
        uci set firewall.ts_fix_iot2ts.dest=tailscale0
        uci set firewall.ts_fix_ts2iot=forwarding
        uci set firewall.ts_fix_ts2iot.src=tailscale0
        uci set firewall.ts_fix_ts2iot.dest=iot
        _fw_dirty=1
    fi
else
    if [ -n "$(uci -q get firewall.ts_fix_iot2ts)" ]; then
        uci -q delete firewall.ts_fix_iot2ts
        uci -q delete firewall.ts_fix_ts2iot
        _fw_dirty=1
    fi
fi

# Single firewall commit + reload for all accumulated guest/IoT forwarding changes
[ "$_fw_dirty" = "1" ] && { uci commit firewall; /etc/init.d/firewall reload; }

# A pass reaching here applied every daemon-level setting against a Running daemon — nothing pends —
# unless Route Guest's read of the advertised routes failed above, which leaves the flag behind.
if [ "$routes_unread" = "1" ]; then
    touch /tmp/ts-fix-daemon-pending 2>/dev/null
else
    rm -f /tmp/ts-fix-daemon-pending 2>/dev/null
fi

# The kill switch is applied near the top of this script (right after the
# flock), before the daemon waits, driven purely by the user's kill_switch
# intent. Nothing exit-node-dependent remains here — see the "Kill switch
# (two layers)" block above.

# Explicit success — earlier idempotent ip/uci deletes can return nonzero when
# the target is already absent (normal no-op paths); don't propagate as failure.
exit 0
